<Project>
  <UsingTask TaskName="ApplyInstallerManifest" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
      <Manifest ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;

public sealed class ApplyInstallerManifest : Microsoft.Build.Utilities.Task
{
    [Microsoft.Build.Framework.Required] public string Executable { get; set; }
    [Microsoft.Build.Framework.Required] public string Manifest { get; set; }
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern IntPtr BeginUpdateResource(string file, bool deleteExisting);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool UpdateResource(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, uint length);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool EndUpdateResource(IntPtr update, bool discard);
    public override bool Execute()
    {
        string manifestText = File.ReadAllText(Manifest);
        byte[] manifest = Encoding.UTF8.GetBytes(manifestText.Replace("uiAccess=\"true\"", "uiAccess=\"false\""));
        IntPtr update = BeginUpdateResource(Executable, false);
        if (update == IntPtr.Zero) throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());
        if (!UpdateResource(update, (IntPtr)24, (IntPtr)1, 0, manifest, (uint)manifest.Length))
        {
            int error = Marshal.GetLastWin32Error();
            EndUpdateResource(update, true);
            throw new System.ComponentModel.Win32Exception(error);
        }
        if (!EndUpdateResource(update, false)) throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());
        return true;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CreateInstallerHost" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PublishDir)BASpark.Setup.exe"
                   AppBinaryName="$(AssemblyName).dll" IntermediateAssembly="$(TargetPath)"
                   WindowsGraphicalUserInterface="true" />
    <ApplyInstallerManifest Executable="$(PublishDir)BASpark.Setup.exe" Manifest="$(ApplicationManifest)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFiles="$(PublishDir)BASpark.Setup.pri" />
    <PropertyGroup>
      <InstallerFrontendRoot>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(PublishDir)'))))</InstallerFrontendRoot>
    </PropertyGroup>
    <ItemGroup>
      <InstallerFrontendFile Include="$(PublishDir)BASpark.Setup.exe;$(PublishDir)BASpark.dll;$(PublishDir)BASpark.deps.json;$(PublishDir)BASpark.runtimeconfig.json;$(PublishDir)BASpark*.pri;$(PublishDir)*.xbf;
                                      $(PublishDir)System.*.dll;$(PublishDir)Microsoft.Win32.*.dll;$(PublishDir)Microsoft.CSharp.dll;$(PublishDir)mscorlib.dll;$(PublishDir)netstandard.dll;
                                      $(PublishDir)coreclr.dll;$(PublishDir)clrgc.dll;$(PublishDir)clrjit.dll;$(PublishDir)hostfxr.dll;$(PublishDir)hostpolicy.dll;
                                      $(PublishDir)CoreMessagingXP.dll;$(PublishDir)dcompi.dll;$(PublishDir)dwmcorei.dll;$(PublishDir)DwmSceneI.dll;$(PublishDir)DWriteCore.dll;$(PublishDir)marshal.dll;$(PublishDir)MRM.dll;$(PublishDir)wuceffectsi.dll;$(PublishDir)WinUIEdit.dll;
                                      $(PublishDir)WinRT.Runtime.dll;$(PublishDir)Microsoft.DirectManipulation.dll;$(PublishDir)Microsoft.InputStateManager.dll;$(PublishDir)Microsoft.Internal.FrameworkUdk.dll;$(PublishDir)Microsoft.InteractiveExperiences.Projection.dll;
                                      $(PublishDir)Microsoft.WinUI.dll;$(PublishDir)Microsoft.UI*.dll;$(PublishDir)Microsoft.UI*.pri;$(PublishDir)Microsoft.UI.Xaml\Assets\**\*;
                                      $(PublishDir)en-us\*.mui;$(PublishDir)zh-CN\*.mui;$(PublishDir)ja-JP\*.mui;$(PublishDir)en\BASpark.resources.dll;$(PublishDir)ja\BASpark.resources.dll;
                                      $(PublishDir)Microsoft.Windows.SDK.NET.dll;$(PublishDir)Microsoft.Windows.ApplicationModel.Resources*.dll;$(PublishDir)Microsoft.Windows.Storage*.dll;$(PublishDir)Microsoft.Windows.Foundation.Projection.dll;$(PublishDir)Microsoft.WindowsAppRuntime*.dll;$(PublishDir)Microsoft.WindowsAppRuntime.pri"
                             Exclude="$(PublishDir)System.Windows*.dll;$(PublishDir)System.Xaml.dll;$(PublishDir)System.Printing.dll;$(PublishDir)System.IO.Packaging.dll" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)BASpark.Setup.files"
                      Lines="@(InstallerFrontendFile->Metadata('FullPath')->Replace('$(InstallerFrontendRoot)', '')->Distinct())"
                      Encoding="ASCII" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
