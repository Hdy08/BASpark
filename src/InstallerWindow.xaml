<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BASpark.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}">
    <UserControl.Resources>
        <Thickness x:Key="ToggleSwitchHeaderMargin">0</Thickness>
        <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
        <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
        <Thickness x:Key="InfoBarIconMargin">0,0,14,0</Thickness>
        <Thickness x:Key="InfoBarTitleHorizontalOrientationMargin">0</Thickness>
        <Thickness x:Key="InfoBarMessageHorizontalOrientationMargin">12,0,0,0</Thickness>
        <Thickness x:Key="InfoBarTitleVerticalOrientationMargin">0</Thickness>
        <Thickness x:Key="InfoBarMessageVerticalOrientationMargin">0</Thickness>
        <Thickness x:Key="InfoBarPanelVerticalOrientationPadding">0,12,0,12</Thickness>
        <Style x:Key="InstallerBodyLargeStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InstallerInfoBarStyle" TargetType="InfoBar" BasedOn="{StaticResource BasStartupInfoBarStyle}">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="CornerRadius" Value="{StaticResource BasSettingCardCornerRadius}" />
        </Style>
        <Style x:Key="InstallerChoiceStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="{ThemeResource BasSidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False"
                      Background="{ThemeResource BasSidebarBackgroundBrush}" />
            <Button x:Name="BtnCaptionClose" Grid.Column="1" Width="46" Height="32" Padding="0"
                    Background="#00E81123" BorderThickness="0" CornerRadius="0" Click="Cancel_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A2231A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </Grid>
        <ContentControl x:Name="PageContent" Grid.Row="1" Margin="28,16,28,0"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="28" VerticalOffset="0" />
                </TransitionCollection>
            </ContentControl.ContentTransitions>
        </ContentControl>
        <StackPanel Grid.Row="2" Padding="28,12,28,16" Spacing="8">
            <CheckBox x:Name="CheckAgreement" Style="{StaticResource InstallerChoiceStyle}" Loaded="Choice_Loaded"
                      IsChecked="False" Checked="Choice_Changed" Unchecked="Choice_Changed" />
            <StackPanel x:Name="InstallChoices" Spacing="4">
                <CheckBox x:Name="CheckDesktop" Style="{StaticResource InstallerChoiceStyle}" Loaded="Choice_Loaded" IsChecked="False" />
                <CheckBox x:Name="CheckCertificate" Style="{StaticResource InstallerChoiceStyle}" Loaded="Choice_Loaded"
                          IsChecked="False" Checked="Choice_Changed" Unchecked="Choice_Changed">
                    <CheckBox.Content><TextBlock x:Name="CertificateConsent" TextWrapping="Wrap" /></CheckBox.Content>
                </CheckBox>
            </StackPanel>
            <CheckBox x:Name="CheckLaunch" Style="{StaticResource InstallerChoiceStyle}" Loaded="Choice_Loaded" IsChecked="True" />
            <CheckBox x:Name="CheckKeepData" Style="{StaticResource InstallerChoiceStyle}" Loaded="Choice_Loaded" IsChecked="True" />
            <StackPanel x:Name="ActionButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="BtnCancel" Click="Cancel_Click" />
                <Button x:Name="BtnBack" Click="Back_Click" />
                <Button x:Name="BtnNext" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
            </StackPanel>
        </StackPanel>
        <Grid x:Name="PagePool" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="LanguagePage" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LanguageTitle" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="LanguagePrompt" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                    <Border Style="{StaticResource BasSettingCardStyle}" Margin="0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Style="{StaticResource BasSettingTitleStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ComboLanguage" Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                      VerticalContentAlignment="Center" SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                            </ComboBox>
                        </Grid>
                    </Border>
            </StackPanel>
            <Grid x:Name="WelcomePage" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="WelcomeTagline" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                <ScrollViewer x:Name="WelcomeScroller" Grid.Row="1" Margin="0,0,-28,0" Padding="0,0,28,0"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="WelcomeIntro" Style="{StaticResource InstallerBodyLargeStrongTextStyle}" />
                        <StackPanel Spacing="4">
                    <InfoBar Style="{StaticResource InstallerInfoBarStyle}" Severity="Informational" Loaded="WelcomeInfo_Loaded">
                        <StackPanel Spacing="4" Margin="0,8,16,8">
                            <TextBlock x:Name="OpenSourceTitle" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="OpenSourceBody" Style="{StaticResource BasCaptionStyle}" />
                        </StackPanel>
                    </InfoBar>
                    <InfoBar Style="{StaticResource InstallerInfoBarStyle}" Severity="Warning" Loaded="WelcomeInfo_Loaded">
                        <StackPanel Spacing="4" Margin="0,8,16,8">
                            <TextBlock x:Name="SecurityTitle" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="SecurityBody" Style="{StaticResource BasCaptionStyle}" />
                        </StackPanel>
                    </InfoBar>
                    <InfoBar Style="{StaticResource InstallerInfoBarStyle}" Severity="Success" Loaded="WelcomeInfo_Loaded">
                        <StackPanel Spacing="4" Margin="0,8,16,8">
                            <TextBlock x:Name="PrivacyTitle" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="PrivacyBody" Style="{StaticResource BasCaptionStyle}" />
                        </StackPanel>
                    </InfoBar>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="ConfirmPage" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ConfirmTitle" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="ConfirmDescription" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                <ScrollViewer x:Name="ConfirmScroller" Grid.Row="1" Margin="0,0,-28,0" Padding="0,0,28,0"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConfirmCards" Spacing="4">
                    <Border x:Name="DirectoryCard" Style="{StaticResource BasSettingCardStyle}" Margin="0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DirectoryLabel" Style="{StaticResource BasSettingTitleStyle}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="DirectoryInput" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         Loaded="Input_Loaded" TextChanged="Directory_Changed" />
                                <Button x:Name="BtnBrowse" Grid.Column="1" Width="32" Height="32" Padding="0" Click="Browse_Click">
                                    <FontIcon Glyph="&#xEC50;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}" Margin="0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartMenuLabel" Style="{StaticResource BasSettingTitleStyle}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="StartMenuInput" Text="BASpark" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         Loaded="Input_Loaded" TextChanged="Directory_Changed" />
                                <ToggleSwitch x:Name="ToggleStartMenu" Grid.Column="1" IsOn="True"
                                              Style="{StaticResource BasSettingToggleStyle}" Toggled="StartMenu_Toggled" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="ProgressPage" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="ProgressDescription" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                <ProgressBar x:Name="InstallProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" />
                <Grid x:Name="ProgressOutput" Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource BasLogCardStyle}" Margin="0">
                        <ScrollViewer x:Name="OutputScroller" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OutputText" Margin="16" FontFamily="Consolas" FontSize="{StaticResource BasFontSizeCaption}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <StackPanel x:Name="CompletePage" Spacing="20">
                <TextBlock x:Name="CompleteTitle" Style="{StaticResource BasPageTitleStyle}" />
                <StackPanel x:Name="CompleteMessages" Spacing="4">
                <InfoBar x:Name="CompleteInfo" Style="{StaticResource InstallerInfoBarStyle}"
                         Severity="Success" Loaded="WelcomeInfo_Loaded" />
                <InfoBar x:Name="CompleteDirectoryCard" Style="{StaticResource InstallerInfoBarStyle}"
                         Severity="Informational" Loaded="WelcomeInfo_Loaded">
                    <StackPanel Spacing="4" Margin="0,8,16,8">
                        <TextBlock x:Name="CompleteDirectoryLabel" Style="{StaticResource BasSettingTitleStyle}" />
                        <TextBlock x:Name="CompleteDirectory" Style="{StaticResource BasCaptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </InfoBar>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="UninstallPage" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="UninstallTitle" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="UninstallDescription" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                <InfoBar x:Name="UninstallProductCard" Style="{StaticResource InstallerInfoBarStyle}"
                         Severity="Informational" Loaded="WelcomeInfo_Loaded">
                    <StackPanel Spacing="4" Margin="0,8,16,8">
                        <TextBlock x:Name="UninstallProduct" Style="{StaticResource BasSettingTitleStyle}" />
                        <TextBlock x:Name="UninstallDirectory" Style="{StaticResource BasCaptionStyle}" />
                    </StackPanel>
                </InfoBar>
            </StackPanel>
            <InfoBar x:Name="ErrorInfo" Style="{StaticResource InstallerInfoBarStyle}" IsOpen="False"
                     Visibility="Collapsed" Severity="Error" Loaded="WelcomeInfo_Loaded" />
        </Grid>
    </Grid>
</UserControl>
