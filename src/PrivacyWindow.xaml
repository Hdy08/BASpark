<Window x:Class="BASpark.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 BASpark" Height="660" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        Topmost="True" Background="{DynamicResource ThemeSurfaceBackgroundBrush}">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeSurfaceBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeStartupBorderBrush" Color="#EDF2F7"/>
        <SolidColorBrush x:Key="ThemeDangerSoftBackgroundBrush" Color="#FFF5F5"/>
        <SolidColorBrush x:Key="ThemeDangerButtonBorderBrush" Color="#FFCCCC"/>
        <SolidColorBrush x:Key="ThemePrivacyIntroTextBrush" Color="#2D3748"/>
        <SolidColorBrush x:Key="ThemePrivacyBodyTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="ThemePrivacySectionTitleBrush" Color="#4A5568"/>
        <SolidColorBrush x:Key="ThemePrivacyTelemetryTextBrush" Color="#A0AEC0"/>
        <SolidColorBrush x:Key="ThemePrivacyWarningTitleBrush" Color="#E53E3E"/>
        <SolidColorBrush x:Key="ThemePrivacyWarningTextBrush" Color="#C53030"/>
        <SolidColorBrush x:Key="ThemePrivacyRefuseBackgroundBrush" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="ThemePrivacyRefuseForegroundBrush" Color="#A0AEC0"/>
        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/> <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#45AFFF">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="✨ BASpark" FontSize="30" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Version" FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="VersionText" Text="1.6.2-beta2" FontSize="12" FontWeight="Bold" Foreground="White" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtTagline" Text="Sensei, welcome back to Schale." FontSize="11" Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="40,25" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtIntro" Text="在使用本软件前，请详细阅读以下内容：" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemePrivacyIntroTextBrush}" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock x:Name="TxtOpenSourceTitle" Text="● 开源声明" FontWeight="Bold" Foreground="#45AFFF" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtOpenSourceBody" Text="本软件完全开源且免费。严禁商业倒卖，若您是付费取得，请立即向平台举报并申请退款。" TextWrapping="Wrap" Foreground="{DynamicResource ThemePrivacyBodyTextBrush}" FontSize="13" LineHeight="20"/>
                </StackPanel>

                <Border Background="{DynamicResource ThemeDangerSoftBackgroundBrush}" Padding="12" CornerRadius="6" Margin="0,5,0,15" BorderBrush="{DynamicResource ThemeDangerButtonBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TxtSecurityTitle" Text="● 安全预警 (重要)" FontWeight="Bold" Foreground="{DynamicResource ThemePrivacyWarningTitleBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtSecurityBody" Text="请确保从官方渠道下载。第三方渠道提供的版本可能存在被篡改或报毒的风险。" TextWrapping="Wrap" Foreground="{DynamicResource ThemePrivacyWarningTextBrush}" FontSize="13" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock x:Name="TxtPrivacyTitle" Text="● 隐私保障" FontWeight="Bold" Foreground="{DynamicResource ThemePrivacySectionTitleBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtPrivacyBody" Text="绝不收集您的按键内容、文件或任何私密信息。所有特效渲染均在本地完成。" TextWrapping="Wrap" Foreground="{DynamicResource ThemePrivacyBodyTextBrush}" FontSize="13" LineHeight="20"/>
                </StackPanel>

                <CheckBox Name="CheckTelemetry" IsChecked="True" Margin="0,15,0,0" Cursor="Hand" VerticalContentAlignment="Center">
                    <TextBlock x:Name="TxtTelemetry" Text="同意加入用户体验改进计划 (匿名统计)" Foreground="{DynamicResource ThemePrivacyTelemetryTextBrush}" FontSize="12"/>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeStartupBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnRefuse" Content="拒绝并退出" Click="BtnRefuse_Click" Width="140" Height="45" 
                        Background="{DynamicResource ThemePrivacyRefuseBackgroundBrush}" Foreground="{DynamicResource ThemePrivacyRefuseForegroundBrush}" Style="{StaticResource RoundedBtn}" Cursor="Hand" Margin="0,0,20,0"/>
                <Button x:Name="BtnAgree" Content="同意并进入" Click="BtnAgree_Click" Width="140" Height="45" 
                        Background="#45AFFF" Foreground="White" Style="{StaticResource RoundedBtn}" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
