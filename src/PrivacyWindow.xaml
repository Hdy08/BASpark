<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动的隐私 / 遥测说明对话框（原生 WinUI 3 窗口）。

    所有静态文案沿用迁移前的本地化键，在代码里填充（见 PrivacyWindow.ApplyLocalizedText）；
    版本号在代码里读取程序集版本（见 PrivacyWindow.LoadVersion）。
-->
<Window
    x:Class="BASpark.PrivacyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasSidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 使用 WinUI 原生 TitleBar 控件；窗口已 ExtendsContentIntoTitleBar，系统标题栏不再绘制。 -->
        <Grid Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TitleBar x:Name="AppTitleBar" Grid.Column="0"
                      Background="{ThemeResource BasSidebarBackgroundBrush}"
                      Title="" Subtitle=""
                      IsBackButtonVisible="False" IsPaneToggleButtonVisible="False" />
            <Button x:Name="BtnCaptionClose" Grid.Column="1" Width="46" Height="32" Padding="0"
                    Background="#00E81123" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Top" Click="CaptionClose_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A2231A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="{StaticResource BasStartupContentMargin}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="TxtTagline" Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>
                <TextBlock x:Name="TxtIntro"
                           Margin="0,8,0,0"
                           Style="{StaticResource BasSectionTitleStyle}" />

                <InfoBar Style="{StaticResource BasStartupInfoBarStyle}" Severity="Informational" Loaded="WelcomeInfoBar_Loaded">
                    <StackPanel Spacing="4" Margin="0,12,16,12">
                        <TextBlock x:Name="TxtOpenSourceTitle"
                                   Style="{StaticResource BasSectionTitleStyle}" />
                        <TextBlock x:Name="TxtOpenSourceBody"
                                   Style="{StaticResource BasCaptionStyle}" />
                    </StackPanel>
                </InfoBar>

                <InfoBar Style="{StaticResource BasStartupInfoBarStyle}" Severity="Warning" Loaded="WelcomeInfoBar_Loaded">
                    <StackPanel Spacing="4" Margin="0,12,16,12">
                        <TextBlock x:Name="TxtSecurityTitle"
                                    Style="{StaticResource BasSectionTitleStyle}" />
                        <TextBlock x:Name="TxtSecurityBody"
                                    Style="{StaticResource BasCaptionStyle}" />
                    </StackPanel>
                </InfoBar>

                <InfoBar Style="{StaticResource BasStartupInfoBarStyle}" Severity="Success" Loaded="WelcomeInfoBar_Loaded">
                    <StackPanel Spacing="4" Margin="0,12,16,12">
                        <TextBlock x:Name="TxtPrivacyTitle"
                                   Style="{StaticResource BasSectionTitleStyle}" />
                        <TextBlock x:Name="TxtPrivacyBody"
                                   Style="{StaticResource BasCaptionStyle}" />
                    </StackPanel>
                </InfoBar>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BasStartupActionBarStyle}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="BtnRefuse"
                        Click="BtnRefuse_Click" />
                <Button x:Name="BtnAgree"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="BtnAgree_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
