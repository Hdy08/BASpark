<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动的隐私 / 遥测说明对话框（原生 WinUI 3 窗口）。

    所有静态文案沿用迁移前的本地化键，在代码里填充（见 PrivacyWindow.ApplyLocalizedText）；
    版本号在代码里读取程序集版本（见 PrivacyWindow.LoadVersion）。
-->
<Window
    x:Class="BASpark.PrivacyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 使用 WinUI 原生 TitleBar 控件；窗口已 ExtendsContentIntoTitleBar，系统标题栏不再绘制。 -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title=""
                  Subtitle=""
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False" />

        <Border Grid.Row="1"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Padding="24,22">
            <StackPanel Spacing="6">
                <TextBlock Text="✨ BASpark"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="6">
                    <TextBlock Text="Version"
                               FontSize="11"
                               VerticalAlignment="Bottom"
                               Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VersionText"
                               Text="1.0.0-release"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="TxtTagline"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="24,20,24,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,0,20">
                <TextBlock x:Name="TxtIntro"
                           Style="{StaticResource BasSectionTitleStyle}" />

                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtOpenSourceTitle"
                               Style="{StaticResource BasSectionTitleStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TxtOpenSourceBody"
                               Style="{StaticResource BasPageSubtitleStyle}" />
                </StackPanel>

                <Border Background="{ThemeResource BasDangerousSubtleBrush}"
                        BorderBrush="{ThemeResource BasDangerousBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BasCardCornerRadius}"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TxtSecurityTitle"
                                   Style="{StaticResource BasSectionTitleStyle}"
                                   Foreground="{ThemeResource BasDangerousBrush}" />
                        <TextBlock x:Name="TxtSecurityBody"
                                   Style="{StaticResource BasPageSubtitleStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtPrivacyTitle"
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBlock x:Name="TxtPrivacyBody"
                               Style="{StaticResource BasPageSubtitleStyle}" />
                </StackPanel>

                <CheckBox x:Name="CheckTelemetry"
                          IsChecked="True" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                BorderBrush="{ThemeResource BasDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <Button x:Name="BtnRefuse"
                        MinWidth="140"
                        MinHeight="40"
                        Click="BtnRefuse_Click" />
                <Button x:Name="BtnAgree"
                        MinWidth="140"
                        MinHeight="40"
                        FontWeight="SemiBold"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="BtnAgree_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
