<?xml version="1.0" encoding="utf-8"?>
<!--
    取色器（原生 WinUI 3 窗口）。

    与迁移前的 WPF 版本相比：
      * 窗口尺寸 / 置顶等由 AppWindow 在代码里设置（WinUI 的 Window 没有 Width/Height）
      * 结果通过 ColorPickerWindow.ShowDialogAsync(XamlRoot) 返回，不再有 DialogResult
      * 全部控件使用 WinUI 内置模板，配色取自 DesignSystem.xaml 的 Bas* 资源
      * 文案在代码里按本地化键填充（见 ColorPickerWindow.ApplyLocalizedText）
-->
<Window
    x:Class="BASpark.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource BasPageBackgroundBrush}"
          KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,16,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LblHueSaturation"
                       Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource BasCaptionStyle}" />

            <TextBlock x:Name="LblBrightness"
                       Grid.Row="0" Grid.Column="2"
                       Style="{StaticResource BasCaptionStyle}"
                       TextAlignment="Center" />

            <!-- 色相（水平）× 饱和度（垂直）二维取色区 -->
            <Border x:Name="ColorField"
                    Grid.Row="1" Grid.Column="0"
                    Margin="0,6,0,0"
                    BorderBrush="{ThemeResource BasControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BasControlCornerRadius}"
                    PointerPressed="ColorField_PointerPressed"
                    PointerMoved="ColorField_PointerMoved"
                    PointerReleased="ColorField_PointerReleased"
                    PointerCaptureLost="ColorField_PointerCaptureLost"
                    PointerCanceled="ColorField_PointerCaptureLost">
                <Grid x:Name="ColorFieldSurface" SizeChanged="ColorFieldSurface_SizeChanged">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.166667" />
                                <GradientStop Color="#FF00FF00" Offset="0.333333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.666667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.833333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="BrightnessOverlay"
                               Fill="Black"
                               Opacity="0"
                               IsHitTestVisible="False" />

                    <Canvas x:Name="ColorFieldMarkerCanvas" IsHitTestVisible="False">
                        <Grid x:Name="ColorFieldMarker" Width="16" Height="16">
                            <Ellipse Stroke="#99000000" StrokeThickness="3" />
                            <Ellipse Margin="2" Stroke="#FFF8FBFF" StrokeThickness="1.5" />
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 明度：垂直滑杆，底部是滑杆背后的明度渐变 -->
            <Border Grid.Row="1" Grid.Column="2"
                    Margin="0,6,0,0"
                    BorderBrush="{ThemeResource BasControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BasControlCornerRadius}">
                <Grid>
                    <Rectangle x:Name="BrightnessTrackFill" RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Slider x:Name="BrightnessSlider"
                            Orientation="Vertical"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.01"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            ValueChanged="BrightnessSlider_ValueChanged" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,14,0,0" Spacing="6">
                <TextBlock x:Name="LblPreview"
                           Style="{StaticResource BasCaptionStyle}" />
                <Border x:Name="ColorPreview"
                        Height="40"
                        BorderBrush="{ThemeResource BasControlStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BasControlCornerRadius}" />
            </StackPanel>

            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                  Margin="0,14,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="LblRed"
                               Style="{StaticResource BasCaptionStyle}" />
                    <TextBox x:Name="TxtRed"
                             MaxLength="3"
                             PreviewKeyDown="ColorInput_PreviewKeyDown"
                             GotFocus="ColorInput_GotFocus"
                             LostFocus="RgbTextBox_LostFocus" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="LblGreen"
                               Style="{StaticResource BasCaptionStyle}" />
                    <TextBox x:Name="TxtGreen"
                             MaxLength="3"
                             PreviewKeyDown="ColorInput_PreviewKeyDown"
                             GotFocus="ColorInput_GotFocus"
                             LostFocus="RgbTextBox_LostFocus" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock x:Name="LblBlue"
                               Style="{StaticResource BasCaptionStyle}" />
                    <TextBox x:Name="TxtBlue"
                             MaxLength="3"
                             PreviewKeyDown="ColorInput_PreviewKeyDown"
                             GotFocus="ColorInput_GotFocus"
                             LostFocus="RgbTextBox_LostFocus" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,14,0,0" Spacing="4">
                <TextBlock x:Name="LblHex"
                           Style="{StaticResource BasCaptionStyle}" />
                <TextBox x:Name="TxtHex"
                         MaxLength="7"
                         PreviewKeyDown="ColorInput_PreviewKeyDown"
                         GotFocus="ColorInput_GotFocus"
                         LostFocus="HexTextBox_LostFocus" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource BasLayerBrush}"
                BorderBrush="{ThemeResource BasDividerBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="18,12">
                <Button x:Name="BtnCancel"
                        MinWidth="88"
                        Click="Cancel_Click" />
                <Button x:Name="BtnConfirm"
                        MinWidth="88"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
