<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BASpark.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 默认控件主题 -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- BASpark 设计令牌与样式 -->
                <ResourceDictionary Source="ms-appx:///DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#429CE3</Color>
            <Color x:Key="SystemAccentColorLight2">#76B9ED</Color>
            <Color x:Key="SystemAccentColorLight3">#A6D8FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0063B1</Color>
            <Color x:Key="SystemAccentColorDark2">#004578</Color>
            <Color x:Key="SystemAccentColorDark3">#00263E</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
