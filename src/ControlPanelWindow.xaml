                    <TextBlock x:Name="TxtOverlayVisualReset"
                               Grid.Row="0"
                               Text=""
                               TextWrapping="Wrap"
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchVisualReset" TextChanged="SearchVisualReset_TextChanged" />
                        <Button x:Name="BtnResetInvert" Grid.Column="1" Width="32" Height="32" MinWidth="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="InvertSelection_Click">
                            <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnResetSelectAll" Grid.Column="2" Width="32" Height="32" MinWidth="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="SelectAll_Click">
                            <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ResetGroupHeader" ColumnSpacing="8" Margin="0,8,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtResetGroup" Style="{StaticResource BasSectionTitleStyle}" VerticalAlignment="Center" />
                            <Button x:Name="BtnResetGroupInvert" Grid.Column="1" Width="32" Height="32" MinWidth="0" Padding="0" Click="InvertSelection_Click"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            <Button x:Name="BtnResetGroupSelectAll" Grid.Column="2" Width="32" Height="32" MinWidth="0" Padding="0" Click="SelectAll_Click"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    <ScrollViewer x:Name="ResetItemsScrollViewer" Grid.Row="1" Margin="0,0,-16,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListVisualResetItems" Style="{StaticResource SelectionListStyle}"
                                      MinHeight="0" HorizontalContentAlignment="Stretch"
                                      ItemTemplateSelector="{StaticResource SelectionCardTemplates}" />
                    </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="TxtResetNoResults" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BasCaptionStyle}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayVisualCancel"
                                Content=""
                                Click="CloseVisualResetOverlay_Click" />
                        <Button x:Name="BtnOverlayVisualConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmVisualReset_Click" />
                    </StackPanel>
                </Grid>
        </ContentDialog>

        <ContentDialog x:Name="BackupOverlay" Style="{StaticResource BasContentDialogStyle}">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">540</x:Double>
            </ContentDialog.Resources>
            <Grid MaxHeight="506">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtBackupSelectionTitle" Grid.Row="0" Text="" TextWrapping="Wrap"
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBackupItems" TextChanged="SearchBackupItems_TextChanged" />
                        <Button x:Name="BtnBackupInvert" Grid.Column="1" Width="32" Height="32" MinWidth="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="InvertSelection_Click">
                            <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnBackupSelectAll" Grid.Column="2" Width="32" Height="32" MinWidth="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="SelectAll_Click">
                            <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="BackupGroupHeader" ColumnSpacing="8" Margin="0,8,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtBackupGroup" Style="{StaticResource BasSectionTitleStyle}" VerticalAlignment="Center" />
                            <Button x:Name="BtnBackupGroupInvert" Grid.Column="1" Width="32" Height="32" MinWidth="0" Padding="0" Click="InvertSelection_Click"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            <Button x:Name="BtnBackupGroupSelectAll" Grid.Column="2" Width="32" Height="32" MinWidth="0" Padding="0" Click="SelectAll_Click"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    <ScrollViewer x:Name="BackupItemsScrollViewer" Grid.Row="1" Margin="0,0,-16,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListBackupItems" MinHeight="0" Style="{StaticResource SelectionListStyle}"
                                      HorizontalContentAlignment="Stretch"
                                      ItemTemplateSelector="{StaticResource SelectionCardTemplates}" />
                    </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="TxtBackupNoResults" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BasCaptionStyle}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnBackupCancel" Content="" Click="CloseBackupOverlay_Click" />
                        <Button x:Name="BtnBackupConfirm" Content="" Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmBackup_Click" />
                    </StackPanel>
                </Grid>
        </ContentDialog>

        <!-- 配置组重命名 -->
        <ContentDialog x:Name="RenameProfileOverlay" Style="{StaticResource BasContentDialogStyle}">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">540</x:Double>
            </ContentDialog.Resources>
            <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename"
                               Text=""
                               TextWrapping="Wrap"
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="NewProfileNameInput" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayRenameCancel"
                                Content=""
                                Click="CloseRenameOverlay_Click" />
                        <Button x:Name="BtnOverlayRenameConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmRenameProfile_Click" />
                    </StackPanel>
                </StackPanel>
        </ContentDialog>

        </Grid>
    </Grid>
    </Grid>
</UserControl>
