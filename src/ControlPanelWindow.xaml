                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtAddProcess"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" MaxWidth="240" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <StackPanel Spacing="8">
                                            <TextBox
                                                x:Name="ManualProcessInput"
                                                MinWidth="0"
                                                PlaceholderText="notepad.exe"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Text, ElementName=TxtAddProcess}" />
                                            <Grid ColumnSpacing="4" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Button
                                                    x:Name="BtnAddProcess"
                                                    Content=""
                                                    Click="AddManualProcess_Click"
                                                    Grid.Column="0"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                                <Button
                                                    x:Name="BtnBrowseProcess"
                                                    Content=""
                                                    Click="BrowseProcess_Click"
                                                    Grid.Column="1"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                                <Button
                                                    x:Name="BtnSelectRunningProcess"
                                                    Content=""
                                                    Click="SelectRunningProcess_Click"
                                                    Grid.Column="0"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== 多屏管理 ===== -->
                        <StackPanel x:Name="SectionMultiScreen" Visibility="Collapsed">
                            <Grid ColumnSpacing="12" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TxtMultiScreenTitle"
                                    Grid.Column="0"
                                    Text=""
                                    Style="{StaticResource BasSettingsSectionTitleStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0" />
                                <Button
                                    x:Name="BtnRefreshScreens"
                                    Grid.Column="1"
                                    Content=""
                                    Click="RefreshScreenOptions_Click" />
                            </Grid>
                            <TextBlock
                                x:Name="TxtMultiScreenHint"
                                Text=""
                                Margin="0,0,0,12"
                                Style="{StaticResource BasCaptionStyle}" />
                            <StackPanel
                                x:Name="PanelScreenOptions"
                                Spacing="0" />
                        </StackPanel>

                        <!-- 「更多设置」已移除：仅有的侧边栏背景图功能不再提供。 -->

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 日志 ===== -->
            <Grid x:Name="PageLog" Visibility="Collapsed" Padding="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLogTitle"
                                   Grid.Column="0"
                                   Text=""
                                   Style="{StaticResource BasPageTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnClearLog"
                                Grid.Column="1"
                                Content=""
                                Click="ClearLog_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TxtLogHint"
                               Text=""
                               Margin="0,6,0,0"
                               Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource BasCardStyle}" Margin="0">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtAppLog"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="{StaticResource BasFontSizeCaption}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 关于 ===== -->
            <ScrollViewer x:Name="PageAbout"
                          Visibility="Collapsed"
                          Padding="28"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtAboutTitle"
                               Text=""
                               Style="{StaticResource BasPageTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BASpark"
                                   FontSize="{StaticResource BasFontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutVersionText"
                                   Text="—"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource BasTextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="TxtAboutDescription"
                               Text=""
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource BasTextSecondaryBrush}" />

                    <InfoBar x:Name="SecurityWarningBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Margin="0,16,0,0">
                        <InfoBar.Content>
                            <TextBlock x:Name="TxtSecurityWarning"
                                       Text=""
                                       TextWrapping="Wrap" />
                        </InfoBar.Content>
                    </InfoBar>



                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,24,0,12" />

                    <TextBlock x:Name="TxtDevOptions"
                               Text=""
                               Style="{StaticResource BasFieldLabelStyle}"
                               Foreground="{ThemeResource BasTextTertiaryBrush}" />
                    <Button x:Name="BtnResetAll"
                            Content=""
                            Style="{StaticResource BasDangerButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="ResetConfig_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 模态层 ==================== -->

        <!-- 运行中进程选择 -->
        <Grid x:Name="RunningProcessOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="520"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayRunning"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchRunningProcess"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             PlaceholderText=""
                             TextChanged="SearchRunningProcess_TextChanged" />
                    <ListView x:Name="ListRunningProcesses"
                              Grid.Row="2"
                              SelectionMode="Multiple"
                              MinHeight="240" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayCancel"
                                Content=""
                                Click="CloseRunningProcessOverlay_Click" />
                        <Button x:Name="BtnOverlayConfirmAdd"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmAddRunningProcesses_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 视觉表现恢复默认 -->
        <Grid x:Name="VisualResetOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="560"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayVisualReset"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchVisualReset"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             TextChanged="SearchVisualReset_TextChanged" />
                    <ListView x:Name="ListVisualResetItems"
                              Grid.Row="2"
                              SelectionMode="None"
                              MinHeight="260" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayVisualCancel"
                                Content=""
                                Click="CloseVisualResetOverlay_Click" />
                        <Button x:Name="BtnOverlayVisualConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmVisualReset_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 配置组重命名 -->
        <Grid x:Name="RenameProfileOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="380"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBlock x:Name="TxtOverlayRenamePrompt"
                               Text=""
                               Margin="0,8,0,12"
                               Style="{StaticResource BasCaptionStyle}" />
                    <TextBox x:Name="NewProfileNameInput" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayRenameCancel"
                                Content=""
                                Click="CloseRenameOverlay_Click" />
                        <Button x:Name="BtnOverlayRenameConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmRenameProfile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>
    </Grid>
</UserControl>
