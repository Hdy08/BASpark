<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BASpark.ControlPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:BASpark"
    mc:Ignorable="d"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}">

    <UserControl.Resources>
        <x:Double x:Key="RadioButtonsColumnSpacing">0</x:Double>
        <x:Double x:Key="RadioButtonsRowSpacing">0</x:Double>
        <Thickness x:Key="RadioButtonsTopHeaderMargin">0</Thickness>
        <Thickness x:Key="ToggleSwitchHeaderMargin">0</Thickness>
        <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
        <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
        <ResourceDictionary x:Key="DangerButtonResources">
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A72318" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A72318" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <DataTemplate x:Key="SelectionCardTemplate">
            <Border x:Name="SelectionCard" Style="{StaticResource BasSettingCardStyle}" MinHeight="0" Tapped="SelectionCard_Tapped">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BasSettingTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Visibility="{Binding SubtitleVisibility}" Style="{StaticResource BasCaptionStyle}" />
                    </StackPanel>
                    <CheckBox x:Name="SelectionCardCheck" Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              MinWidth="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Title}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SelectionHeadingTemplate">
            <TextBlock Text="{Binding}" Style="{StaticResource BasSettingsSectionTitleStyle}" IsHitTestVisible="False" />
        </DataTemplate>
        <local:SelectionCardTemplateSelector x:Key="SelectionCardTemplates"
            CardTemplate="{StaticResource SelectionCardTemplate}" HeadingTemplate="{StaticResource SelectionHeadingTemplate}" />
        <Style x:Key="SelectionCardContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource BasPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TitleBar x:Name="AppTitleBar"
                      Grid.Column="0"
                      Title=""
                      Subtitle=""
                      IsBackButtonVisible="False"
                      IsPaneToggleButtonVisible="False" />
            <StackPanel x:Name="CaptionButtons" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="BtnCaptionMinimize"
                        Width="46" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="0"
                        Click="CaptionMinimize_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="BtnCaptionMaximize"
                        Width="46" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="0"
                        Click="CaptionMaximize_Click">
                    <FontIcon x:Name="CaptionMaximizeIcon" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button x:Name="BtnCaptionClose"
                        Width="46" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="0"
                        Click="CaptionClose_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A2231A" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="PanelBody" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 侧边栏 ==================== -->
        <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource BasSidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自定义背景图铺在最底层 -->
            <Border x:Name="SidebarBackgroundHost" Grid.RowSpan="2" />

            <!--
                所有主标签放在同一个 StackPanel 内，子导航作为「设置」的直接后继。
                这样折叠时不会在「设置」与「日志」之间留下跨容器的固定间距。
            -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,12,8,8">
                <StackPanel Spacing="0">
                    <StackPanel x:Name="NavBeforeSettings" Spacing="4">
                        <RadioButton x:Name="TabWelcome"
                                     GroupName="MainNav"
                                     IsChecked="True"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="16" />
                                <TextBlock x:Name="TabWelcomeLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabSettings"
                                     GroupName="MainNav"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="16" Width="16" />
                                <TextBlock x:Name="TabSettingsLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!--
                        设置子导航：容器高度由 SubNavAnimator 做「依赖动画」+ 裁剪，
                        高度逐帧变化，下面的「日志 / 关于」贴着展开边缘被连续推开。
                        不用原生 Expander：实测它不做布局动画（下方导航项在一帧内整段
                        位移 168px），而在它外面套高度动画会破坏它自己的内容定位与裁剪
                        （动画中途子项会跳到错误的行、甚至整段消失）。
                    -->
                    <Border x:Name="SettingsSubNavHost"
                            Margin="0"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                        <StackPanel x:Name="SettingsSubNav" Spacing="2" Margin="0,2,0,0">
                            <RadioButton x:Name="SubTabBasic"
                                         GroupName="SettingsNav"
                                         IsChecked="True"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabBasicLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabVisual"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabVisualLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabFilter"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabFilterLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabMultiScreen"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabMultiScreenLabel" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!--
                        「日志 / 关于」单独成组：设置子导航展开/收起时，这一组靠独立的
                        平移动画（合成器线程插值，按屏幕刷新率更新）被连续推开，
                        容器自身的布局高度只在切换的那一刻改一次，因此不会掉帧。
                    -->
                    <StackPanel x:Name="NavAfterSettings" Spacing="4" Margin="0,4,0,0">
                        <RadioButton x:Name="TabLog"
                                     GroupName="MainNav"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                <TextBlock x:Name="TabLogLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabAbout"
                                     GroupName="MainNav"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <TextBlock x:Name="TabAboutLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="12,8,12,14" Spacing="2">
                <TextBlock x:Name="TxtSidebarVersion"
                           Text="BASpark"
                           FontSize="{StaticResource BasFontSizeCaption}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource BasTextTertiaryBrush}" />
                <TextBlock x:Name="TxtSidebarCopyright"
                           Text=""
                           FontSize="{StaticResource BasFontSizeCaption}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource BasTextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 内容区 ==================== -->
        <Border x:Name="ContentSurface" Grid.Column="1"
                Background="{ThemeResource BasSettingsPageBackgroundBrush}"
                CornerRadius="6,0,0,0">
        <Grid>

            <!-- ===== 首页 ===== -->
            <ScrollViewer x:Name="PageWelcome"
                          Padding="28,20,28,28"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtWelcomeTitle"
                               Text=""
                               Style="{StaticResource BasSettingsPageTitleStyle}" />
                    <TextBlock x:Name="TxtWelcomeSubtitle"
                               Text=""
                               Margin="0,4,0,24"
                               Style="{StaticResource BasPageSubtitleStyle}" />

                    <!-- 实时统计 -->
                    <TextBlock x:Name="TxtStatsTitle" Text=""
                               Style="{StaticResource BasSettingsSectionTitleStyle}"
                               Margin="0,8,0,8" />
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtStatusLabel" Grid.Column="0" Text=""
                                       Style="{StaticResource BasSettingTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="—"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource BasSettingTitleStyle}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtClicksLabel" Grid.Column="0" Text=""
                                       Style="{StaticResource BasSettingTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ClickCountText" Grid.Column="1" Text="0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource BasSettingTitleStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 设置 ===== -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页头：标题 + 应用按钮 -->
                <Grid Grid.Row="0" Padding="28,20,28,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSettingsTitle"
                                   Text=""
                                   Style="{StaticResource BasSettingsPageTitleStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BtnResetSettings" Content="" Click="OpenAllResetOverlay_Click"
                                Style="{StaticResource BasDangerButtonStyle}" SizeChanged="ResetSettings_SizeChanged">
                        </Button>
                        <Button x:Name="BtnApplySettings" IsEnabled="False" Content="" Click="SaveSettings_Click"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="0" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsContentScrollViewer"
                              Grid.Row="1"
                              Padding="28,0,28,28"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ===== 基础设置 ===== -->
                        <StackPanel x:Name="SectionBasic">
                            <Grid ColumnSpacing="12" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtBasicTitle" Text="" Style="{StaticResource BasSettingsSectionTitleStyle}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button x:Name="BtnBasicReset" Grid.Column="1" Content="" Click="ResetBasicDefaults_Click" />
                            </Grid>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtBasicLanguage"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBox
                                            x:Name="ComboLanguage"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="ComboLanguage_SelectionChanged"
                                            Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                            BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                            AutomationProperties.Name="{Binding Text, ElementName=TxtBasicLanguage}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtDarkMode"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Border Style="{StaticResource BasSegmentedSelectorStyle}">
                                            <RadioButtons
                                                x:Name="RadioDarkMode"
                                                Style="{StaticResource BasSegmentedRadioButtonsStyle}"
                                                MaxColumns="3"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Text, ElementName=TxtDarkMode}" >
                                                <RadioButton x:Name="RadioDarkModeOff" Content="" Style="{StaticResource BasSegmentedRadioStyle}" />
                                                <RadioButton x:Name="RadioDarkModeOn" Content="" Style="{StaticResource BasSegmentedRadioStyle}" />
                                                <RadioButton x:Name="RadioDarkModeSystem" Content="" IsChecked="True" Style="{StaticResource BasSegmentedRadioStyle}" />
                                            </RadioButtons>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckAlwaysTrailEffectSwitch}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckAlwaysTrailEffectSwitch"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckAlwaysTrailEffectSwitch}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckMasterSwitch}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckMasterSwitch"
                                            Header=""
                                            Toggled="CheckMasterSwitch_Changed"
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckMasterSwitch}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="PanelClickEffectOptions">
                                <Border Style="{StaticResource BasSettingCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="Auto" MinWidth="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="TxtClickType"
                                                Text=""
                                                Style="{StaticResource BasSettingTitleStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Border Style="{StaticResource BasSegmentedSelectorStyle}">
                                                <RadioButtons
                                                    x:Name="RadioClickType"
                                                    Style="{StaticResource BasSegmentedRadioButtonsStyle}"
                                                    MaxColumns="3"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Text, ElementName=TxtClickType}" >
                                                    <RadioButton Name="RadioLeftClick" Content="" IsChecked="True" Style="{StaticResource BasSegmentedRadioStyle}" />
                                                    <RadioButton Name="RadioRightClick" Content="" Style="{StaticResource BasSegmentedRadioStyle}" />
                                                    <RadioButton Name="RadioBothClick" Content="" Style="{StaticResource BasSegmentedRadioStyle}" />
                                                </RadioButtons>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource BasSettingCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Header, ElementName=CheckMiddleClickTrigger}" Style="{StaticResource BasSettingTitleStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ToggleSwitch
                                                x:Name="CheckMiddleClickTrigger"
                                                Header=""
                                                Style="{StaticResource BasSettingToggleStyle}"
                                                AutomationProperties.Name="{Binding Header, ElementName=CheckMiddleClickTrigger}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckScreenshotCompatibilityMode}" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock
                                            x:Name="TxtScreenshotHint"
                                            Text=""
                                            Style="{StaticResource BasCaptionStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckScreenshotCompatibilityMode"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckScreenshotCompatibilityMode}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckAutoStart}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckAutoStart"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckAutoStart}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckStartSilent}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckStartSilent"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckStartSilent}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckHideTrayIcon}" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock x:Name="TxtHideTrayHint" Style="{StaticResource BasCaptionStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="CheckHideTrayIcon" Header=""
                                                      Style="{StaticResource BasSettingToggleStyle}"
                                                      AutomationProperties.Name="{Binding Header, ElementName=CheckHideTrayIcon}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckRunAsAdmin}" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock
                                            x:Name="TxtRunAsAdminHint"
                                            Text=""
                                            Style="{StaticResource BasCaptionStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckRunAsAdmin"
                                            Header=""
                                            Toggled="CheckRunAsAdmin_Changed"
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckRunAsAdmin}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckTouchscreenMode}" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock
                                            x:Name="TxtTouchscreenHint"
                                            Text=""
