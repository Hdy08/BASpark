                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtFilterTitle" Text="" Style="{StaticResource BasSettingsSectionTitleStyle}"
