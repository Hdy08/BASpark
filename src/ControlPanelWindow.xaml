                                                <Flyout x:Name="ConfiguredProcessesFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False"
                                                        Opening="ConfiguredProcessesFlyout_Opening" Opened="ConfiguredProcessesFlyout_Opened">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                                            <Setter Property="Padding" Value="0,4,0,4" />
                                                            <Setter Property="MinWidth" Value="0" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <ScrollViewer x:Name="ConfiguredProcessScroller" MaxHeight="200" IsTabStop="True"
                                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl x:Name="ConfiguredProcessItems" HorizontalContentAlignment="Stretch">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid x:Name="ConfiguredProcessItemRoot" ColumnSpacing="8" MinHeight="32" Padding="11,6,11,6" VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1"
                                                                                Click="RemoveProcess_Click"
                                                                                Tag="{Binding}"
                                                                                MinWidth="0" MinHeight="0" Width="20" Height="20" Padding="0"
                                                                                VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                                            <PathIcon Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Data="M0,1 L1,0 L5,4 L9,0 L10,1 L6,5 L10,9 L9,10 L5,6 L1,10 L0,9 L4,5 Z" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtAddProcess" Text="" Style="{StaticResource BasSettingTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnBrowseProcess" Content="" Click="BrowseProcess_Click" />
                                        <Button x:Name="BtnSelectRunningProcess" Grid.Column="1" Content=""
                                                Click="SelectRunningProcess_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== 多屏管理 ===== -->
                        <StackPanel x:Name="SectionMultiScreen" Visibility="Collapsed">
                            <Grid ColumnSpacing="12" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TxtMultiScreenTitle"
                                    Grid.Column="0"
                                    Text=""
                                    Style="{StaticResource BasSettingsSectionTitleStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnRefreshScreens" Content="" Click="RefreshScreenOptions_Click" />
                                    <Button x:Name="BtnScreensReset" Content="" Click="ResetScreenDefaults_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="TxtMultiScreenHint"
                                Text=""
                                Margin="0,0,0,12"
                                Style="{StaticResource BasCaptionStyle}" />
                            <StackPanel
                                x:Name="PanelScreenOptions"
                                Spacing="0" />
                        </StackPanel>

                        <StackPanel x:Name="SectionBackup" Visibility="Collapsed">
                            <TextBlock x:Name="TxtBackupTitle" Text="" Style="{StaticResource BasSettingsSectionTitleStyle}"
                                       Margin="0,8,0,8" />
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExportConfiguration" Text="" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock x:Name="TxtExportConfigurationHint" Text="" Style="{StaticResource BasCaptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="BtnExportConfiguration" Grid.Column="1" Content=""
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExportConfiguration_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtImportConfiguration" Text="" Style="{StaticResource BasSettingTitleStyle}" />
                                        <TextBlock x:Name="TxtImportConfigurationHint" Text="" Style="{StaticResource BasCaptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="BtnImportConfiguration" Grid.Column="1" Content=""
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImportConfiguration_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 日志 ===== -->
            <Grid x:Name="PageLog" Visibility="Collapsed" Padding="28,20,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLogTitle"
                                   Grid.Column="0"
                                   Text=""
                                   Style="{StaticResource BasSettingsPageTitleStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnClearLog" Content="" Click="ClearLog_Click"
                                    Style="{StaticResource BasDangerButtonStyle}" MinWidth="0" />
                            <Button x:Name="BtnCopyLog" Content="" MinWidth="0" Click="CopyLog_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtLogHint"
                               Text=""
                               Margin="0,6,0,0"
                               Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource BasCardStyle}" Margin="0">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtAppLog"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource BasFontSizeCaption}" FontFamily="Consolas" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 关于 ===== -->
            <ScrollViewer x:Name="PageAbout"
                          Visibility="Collapsed"
                          Padding="28,20,28,28"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtAboutTitle" Text="" Style="{StaticResource BasSettingsPageTitleStyle}" />

                    <Border Style="{StaticResource BasSettingCardStyle}" Margin="0,16,0,6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="BASpark" Style="{StaticResource BasSettingTitleStyle}" />
                                <TextBlock x:Name="TxtAboutDescription" Text="" Style="{StaticResource BasCaptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="AboutVersionText" Grid.Column="1" Text="—"
                                       Style="{StaticResource BasSettingTitleStyle}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtRepositoryLinks" Text="" Style="{StaticResource BasSettingsSectionTitleStyle}"
                               Margin="0,20,0,8" />
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HyperlinkButton x:Name="LinkRepoDoomVoss" Content="{Binding Tag, ElementName=BtnRepoDoomVoss}"
                                             NavigateUri="https://github.com/DoomVoss/BASpark" Style="{StaticResource BasRepositoryLinkStyle}" />
                            <Button x:Name="BtnRepoDoomVoss" Grid.Column="1" Content="" Tag="https://github.com/DoomVoss/BASpark"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HyperlinkButton x:Name="LinkRepoCialloKing" Content="{Binding Tag, ElementName=BtnRepoCialloKing}"
                                             NavigateUri="https://github.com/CialloKing/BASpark" Style="{StaticResource BasRepositoryLinkStyle}" />
                            <Button x:Name="BtnRepoCialloKing" Grid.Column="1" Content="" Tag="https://github.com/CialloKing/BASpark"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HyperlinkButton x:Name="LinkRepoWinUI" Content="{Binding Tag, ElementName=BtnRepoWinUI}"
                                             NavigateUri="https://github.com/Hdy08/BASpark/tree/WinUI3" Style="{StaticResource BasRepositoryLinkStyle}" />
                            <Button x:Name="BtnRepoWinUI" Grid.Column="1" Content="" Tag="https://github.com/Hdy08/BASpark/tree/WinUI3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>

        <!-- ==================== 模态层 ==================== -->

        <!-- 运行中进程选择 -->
        <ContentDialog x:Name="RunningProcessOverlay" Style="{StaticResource BasContentDialogStyle}">
