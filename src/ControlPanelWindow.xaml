                            CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                            IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                            SelectedItem="{Binding ElementName=TabWelcome}"
