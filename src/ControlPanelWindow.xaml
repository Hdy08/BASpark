                            </Grid>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckEnvironmentFilter}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckEnvironmentFilter"
                                            Header=""
                                            Toggled="EnvironmentFilterSetting_Changed"
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckEnvironmentFilter}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckHideInFullscreen}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckHideInFullscreen"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckHideInFullscreen}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckShowEffectOnDesktop}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckShowEffectOnDesktop"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckShowEffectOnDesktop}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtFilterProfiles"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Spacing="8">
                                            <ComboBox
                                                x:Name="ComboProfiles"
                                                MinWidth="0"
                                                Width="0"
                                                SelectionChanged="ComboProfiles_SelectionChanged"
                                                HorizontalAlignment="Stretch"
                                                VerticalContentAlignment="Center" Padding="12,0,0,0"
                                                Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                AutomationProperties.Name="{Binding Text, ElementName=TxtFilterProfiles}" />
                                            <Grid x:Name="ProfileActions" ColumnSpacing="8" HorizontalAlignment="Right" SizeChanged="ProfileActions_SizeChanged">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Name="BtnAddProfile"
                                                    Content=""
                                                    Click="AddProfile_Click"
                                                    Grid.Column="0"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Left" />
                                                <Button
                                                    x:Name="BtnRenameProfile"
                                                    Content=""
                                                    Click="RenameProfile_Click"
                                                    Grid.Column="1"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Left" />
                                                <Button
                                                    x:Name="BtnDeleteProfile"
                                                    Content=""
                                                    Style="{StaticResource BasDangerButtonStyle}"
                                                    Click="DeleteProfile_Click"
                                                    Grid.Column="2"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Left" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtFilterMode"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBox x:Name="ComboProcessFilterMode"
                                                  MinWidth="0" HorizontalAlignment="Right"
                                                  VerticalContentAlignment="Center" Padding="12,0,0,0"
                                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                  AutomationProperties.Name="{Binding Text, ElementName=TxtFilterMode}"
                                                  SelectionChanged="ProcessFilterMode_Changed">
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="" />
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtProcessList"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <DropDownButton x:Name="ListConfiguredProcesses"
                                                  MinWidth="0" Height="32"
                                                  HorizontalAlignment="Right" HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" Padding="11,0,13,0"
                                                  Content=""
                                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                  AutomationProperties.Name="{Binding Text, ElementName=TxtProcessList}">
