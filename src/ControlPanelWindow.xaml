                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" Margin="0,0,-16,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListBackupItems" MinHeight="0"
                                      HorizontalContentAlignment="Stretch"
                                      ItemTemplateSelector="{StaticResource SelectionCardTemplates}"
                                      ItemContainerStyle="{StaticResource SelectionCardContainerStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTransitions><TransitionCollection /></ItemsControl.ItemContainerTransitions>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtBackupNoResults" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BasCaptionStyle}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnBackupCancel" Content="" Click="CloseBackupOverlay_Click" />
                        <Button x:Name="BtnBackupConfirm" Content="" Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmBackup_Click" />
                    </StackPanel>
                </Grid>
        </ContentDialog>

        <!-- 配置组重命名 -->
        <ContentDialog x:Name="RenameProfileOverlay" Style="{StaticResource BasContentDialogStyle}">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
                <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">540</x:Double>
            </ContentDialog.Resources>
            <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename"
                               Text=""
                               TextWrapping="Wrap"
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="NewProfileNameInput" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayRenameCancel"
                                Content=""
                                Click="CloseRenameOverlay_Click" />
                        <Button x:Name="BtnOverlayRenameConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmRenameProfile_Click" />
                    </StackPanel>
                </StackPanel>
        </ContentDialog>

        </Grid>
    </Grid>
    </Grid>
</UserControl>
