                                                                         Text="{Binding ElementName=SliderSpeed, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderSpeed" Minimum="0.2" Maximum="3.0" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Name="PanelSplitAnimationSpeed" Margin="0,0,0,15" Visibility="Collapsed">
                                                        <StackPanel Margin="0,0,0,12">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock x:Name="TxtTrailAnimSpeed" Text="拖尾动画速度" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                    <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                             TextAlignment="Right" VerticalAlignment="Center"
                                                                             BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                             Text="{Binding ElementName=SliderTrailAnimSpeed, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                             InputMethod.IsInputMethodEnabled="False"/>
                                                                    <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <Slider Name="SliderTrailAnimSpeed" Minimum="0.2" Maximum="3.0" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                    ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock x:Name="TxtClickAnimSpeed" Text="点击动画速度" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                    <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                             TextAlignment="Right" VerticalAlignment="Center"
                                                                             BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                             Text="{Binding ElementName=SliderClickAnimSpeed, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                             PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                             InputMethod.IsInputMethodEnabled="False"/>
                                                                    <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <Slider Name="SliderClickAnimSpeed" Minimum="0.2" Maximum="3.0" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                    ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <CheckBox Name="CheckFollowDisplayRefreshRate" Content="拖尾刷新率跟随显示器" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>

                                                    <StackPanel Name="PanelTrailRefreshRate" Margin="0,0,0,15">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CheckFollowDisplayRefreshRate}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtTrailRefresh" Text="拖尾刷新率" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                         TextAlignment="Right" VerticalAlignment="Center" 
                                                                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                         Text="{Binding ElementName=SliderTrailRefresh, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text=" Hz" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderTrailRefresh" Minimum="30" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,15">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtTrailDelay" Text="拖尾收回延迟" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                         TextAlignment="Right" VerticalAlignment="Center"
                                                                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                         Text="{Binding ElementName=SliderTrailDelay, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderTrailDelay" Minimum="0.00" Maximum="2.00" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <Separator Background="{DynamicResource ThemeSeparatorBrush}" Margin="0,2,0,12"/>
                                                    <TextBlock x:Name="TxtEffectColor" Text="特效主题颜色" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Name="ColorPreview" Width="40" Height="28" CornerRadius="6" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                                                        <Button x:Name="BtnPickColor" Content="更改颜色" Click="PickColor_Click" Width="90" Height="28" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="#45AFFF" Foreground="#45AFFF" Cursor="Hand" FontSize="12" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SubTabFilter}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtFilterTitle" Text="环境过滤" FontSize="14" FontWeight="Bold" Foreground="#45AFFF" Margin="0,0,0,12"/>

                                                    <CheckBox Name="CheckEnvironmentFilter" Content="启用智能环境探测" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10" Checked="EnvironmentFilterSetting_Changed" Unchecked="EnvironmentFilterSetting_Changed"/>
                                                    <CheckBox Name="CheckHideInFullscreen" Content="全屏应用前台运行时自动暂停" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"/>
                                                    <CheckBox Name="CheckShowEffectOnDesktop" Content="在桌面上显示特效" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,15"/>

                                                    <Separator Background="{DynamicResource ThemeSeparatorBrush}" Margin="0,5,0,15"/>

                                                    <TextBlock x:Name="TxtFilterProfiles" Text="配置组管理" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,10"/>
                                                    <DockPanel Margin="0,0,0,12">
                                                        <Button x:Name="BtnDeleteProfile" Content="删除" Click="DeleteProfile_Click" DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,0" Height="28" Background="{DynamicResource ThemeDangerButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeDangerButtonBorderBrush}" Foreground="{DynamicResource ThemeDangerButtonForegroundBrush}" Style="{DynamicResource DangerActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="BtnRenameProfile" Content="重命名" Click="RenameProfile_Click" DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,0" Height="28" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="BtnAddProfile" Content="新建" Click="AddProfile_Click" DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,0" Height="28" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <ComboBox Name="ComboProfiles" SelectionChanged="ComboProfiles_SelectionChanged" Height="28" VerticalContentAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DockPanel>

                                                    <TextBlock x:Name="TxtFilterMode" Text="过滤模式" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,10"/>
                                                    <ComboBox Name="ComboProcessFilterMode" Width="180" Margin="0,0,0,12" SelectionChanged="ProcessFilterMode_Changed" Height="28" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                                                        <ComboBoxItem Content="🚫 关闭过滤" Tag="Disabled"/>
                                                        <ComboBoxItem Content="❌ 黑名单模式" Tag="Blacklist"/>
                                                        <ComboBoxItem Content="✔ 白名单模式" Tag="Whitelist"/>
                                                    </ComboBox>

                                                    <TextBlock x:Name="TxtProcessList" Text="已配置进程列表" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,10"/>
                                                    <ListBox Name="ListConfiguredProcesses" Height="120" Background="{DynamicResource ThemeListBackgroundBrush}" BorderBrush="{DynamicResource ThemeListBorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel LastChildFill="True" Margin="2">
                                                                    <Button Content="移除" Click="RemoveProcess_Click" DockPanel.Dock="Right" Padding="5,0" Height="22" FontSize="11" Background="{DynamicResource ThemeDangerButtonBackgroundBrush}" Foreground="{DynamicResource ThemeDangerButtonForegroundBrush}" BorderBrush="{DynamicResource ThemeDangerButtonBorderBrush}" Style="{DynamicResource DangerActionButton}">
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                                                    </Button>
                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="5,0"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <TextBlock x:Name="TxtAddProcess" Text="添加进程" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,10"/>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="ManualProcessInput" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Padding="5,0">
                                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                                        </TextBox>
                                                        <Button x:Name="BtnAddProcess" Grid.Column="1" Content="添加" Margin="5,0,0,0" Padding="12,0" Height="30" Click="AddManualProcess_Click" Background="#45AFFF" Foreground="White" Style="{DynamicResource PrimaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="BtnBrowseProcess" Grid.Column="2" Content="浏览..." Margin="5,0,0,0" Padding="12,0" Height="30" Click="BrowseProcess_Click" Background="{DynamicResource ThemeButtonBackgroundBrush}" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="BtnSelectRunningProcess" Grid.Column="3" Content="从运行中选择" Margin="5,0,0,0" Padding="12,0" Height="30" Click="SelectRunningProcess_Click" Background="{DynamicResource ThemeButtonBackgroundBrush}" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SubTabMultiScreen}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock x:Name="TxtMultiScreenTitle" Text="多屏显示管理" FontSize="14" FontWeight="Bold" Foreground="#45AFFF" VerticalAlignment="Center"/>
                                                        <Button x:Name="BtnRefreshScreens" DockPanel.Dock="Right" Content="刷新显示器" Click="RefreshScreenOptions_Click" Padding="10,4" Height="28" Width="200" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Cursor="Hand" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock x:Name="TxtMultiScreenHint" Text="勾选要启用特效窗口的显示器。设置会按显示器名称和硬件 ID 记忆，显示屏变更后自动恢复。" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                                    <ListBox Name="ListScreenOptions" Background="Transparent" BorderThickness="0" MinHeight="180">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="{x:Type ListBoxItem}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0"/>
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                            <ContentPresenter/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="10" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeCardBackgroundBrush}" Padding="12" Margin="0,0,0,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeCardTitleBrush}"/>
                                                                            <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="{DynamicResource ThemeCardSecondaryTextBrush}" Margin="0,4,0,0"/>
                                                                            <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{DynamicResource ThemeCardDetailBrush}" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" Content="{Binding EnableLabel}" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SubTabMore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtMoreTitle" Text="更多设置" FontSize="14" FontWeight="Bold" Foreground="#45AFFF" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="TxtSidebarBackground" Text="主菜单背景图片" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSidebarBackgroundPath" Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeListBorderBrush}" Padding="8,0"/>
                                        <Button x:Name="BtnBrowseSidebarBackground" Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,0" Height="30" Click="BrowseSidebarBackground_Click" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Cursor="Hand" Style="{DynamicResource SecondaryActionButton}">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="BtnClearSidebarBackground" Grid.Column="2" Content="清除" Margin="8,0,0,0" Padding="12,0" Height="30" Click="ClearSidebarBackground_Click" Background="{DynamicResource ThemeDangerSoftBackgroundBrush}" BorderBrush="{DynamicResource ThemeDangerButtonBorderBrush}" Foreground="{DynamicResource ThemeDangerButtonForegroundBrush}" Cursor="Hand" Style="{DynamicResource DangerActionButton}">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="TxtSidebarBackgroundHint" Text="* 支持 PNG/JPG/BMP/WebP" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" TextWrapping="Wrap" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 运行中进程选择弹窗 (Overlay) -->
        <Grid Name="RunningProcessOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Width="400" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="TxtOverlayRunning" Text="从运行中进程添加" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="0,0,0,15"/>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="SearchRunningProcess" Height="30" VerticalContentAlignment="Center" TextChanged="SearchRunningProcess_TextChanged" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Padding="26,0,5,0">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <ListBox Name="ListRunningProcesses" Grid.Row="2" Background="{DynamicResource ThemeListBackgroundBrush}" BorderBrush="{DynamicResource ThemeListBorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="2,4" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="BtnOverlayCancel" Content="取消" Click="CloseRunningProcessOverlay_Click" Width="80" Height="32" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Margin="0,0,10,0" Style="{DynamicResource SecondaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnOverlayConfirmAdd" Content="确认添加" Click="ConfirmAddRunningProcesses_Click" Width="100" Height="32" Background="#45AFFF" Foreground="White" BorderThickness="0" Style="{DynamicResource PrimaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 视觉表现恢复默认 (Overlay) -->
        <Grid Name="VisualResetOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Width="400" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayVisualReset" Text="选择要恢复默认的视觉表现项" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="SearchVisualReset" Height="30" VerticalContentAlignment="Center" TextChanged="SearchVisualReset_TextChanged" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Padding="26,0,5,0">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <ListBox Name="ListVisualResetItems" Grid.Row="2" Background="{DynamicResource ThemeListBackgroundBrush}" BorderBrush="{DynamicResource ThemeListBorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="2,4" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="BtnOverlayVisualCancel" Content="取消" Click="CloseVisualResetOverlay_Click" Width="80" Height="32" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Margin="0,0,10,0" Style="{DynamicResource SecondaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnOverlayVisualConfirm" Content="确认重置" Click="ConfirmVisualReset_Click" Width="100" Height="32" Background="#45AFFF" Foreground="White" BorderThickness="0" Style="{DynamicResource PrimaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Name="RenameProfileOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename" Text="重命名配置组" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtOverlayRenamePrompt" Text="请输入新的配置组名称：" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBox x:Name="NewProfileNameInput" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ThemeElevatedBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Padding="8,0">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BtnOverlayRenameCancel" Content="取消" Click="CloseRenameOverlay_Click" Width="80" Height="32" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Margin="0,0,10,0" Style="{DynamicResource SecondaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnOverlayRenameConfirm" Content="确认修改" Click="ConfirmRenameProfile_Click" Width="100" Height="32" Background="#45AFFF" Foreground="White" BorderThickness="0" Style="{DynamicResource PrimaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
