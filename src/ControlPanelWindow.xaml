                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckHideInFullscreen"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckHideInFullscreen}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Header, ElementName=CheckShowEffectOnDesktop}" Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ToggleSwitch
                                            x:Name="CheckShowEffectOnDesktop"
                                            Header=""
                                            Style="{StaticResource BasSettingToggleStyle}"
                                            AutomationProperties.Name="{Binding Header, ElementName=CheckShowEffectOnDesktop}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtFilterProfiles"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <StackPanel Spacing="8">
                                            <ComboBox
                                                x:Name="ComboProfiles"
                                                MinWidth="0"
                                                SelectionChanged="ComboProfiles_SelectionChanged"
                                                HorizontalAlignment="Stretch"
                                                Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                AutomationProperties.Name="{Binding Text, ElementName=TxtFilterProfiles}" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Name="BtnAddProfile"
                                                    Content=""
                                                    Click="AddProfile_Click"
                                                    Grid.Column="0"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                                <Button
                                                    x:Name="BtnRenameProfile"
                                                    Content=""
                                                    Click="RenameProfile_Click"
                                                    Grid.Column="1"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                                <Button
                                                    x:Name="BtnDeleteProfile"
                                                    Content=""
                                                    Style="{StaticResource BasDangerButtonStyle}"
                                                    Click="DeleteProfile_Click"
                                                    Grid.Column="2"
                                                    Grid.Row="0"
                                                    MinWidth="0"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtFilterMode"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBox x:Name="ComboProcessFilterMode"
                                                  MinWidth="0" HorizontalAlignment="Stretch"
                                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                  AutomationProperties.Name="{Binding Text, ElementName=TxtFilterMode}"
                                                  SelectionChanged="ProcessFilterMode_Changed">
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="" />
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtProcessList"
                                            Text=""
                                            Style="{StaticResource BasSettingTitleStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBox x:Name="ListConfiguredProcesses"
                                                  MinWidth="0" Height="32" MaxDropDownHeight="200"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" Padding="10,0,28,0"
                                                  PlaceholderText="{Binding Text, ElementName=TxtProcessList}"
                                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                                  AutomationProperties.Name="{Binding Text, ElementName=TxtProcessList}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" MinHeight="20" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1"
                                                                Click="RemoveProcess_Click"
                                                                Tag="{Binding}"
                                                                MinWidth="0" MinHeight="0" Width="20" Height="20" Padding="0"
                                                                VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BasSettingCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtAddProcess" Text="" Style="{StaticResource BasSettingTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnBrowseProcess" Content="" Click="BrowseProcess_Click" />
                                        <Button x:Name="BtnSelectRunningProcess" Grid.Column="1" Content=""
                                                Click="SelectRunningProcess_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== 多屏管理 ===== -->
                        <StackPanel x:Name="SectionMultiScreen" Visibility="Collapsed">
                            <Grid ColumnSpacing="12" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TxtMultiScreenTitle"
                                    Grid.Column="0"
                                    Text=""
                                    Style="{StaticResource BasSettingsSectionTitleStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnRefreshScreens" Content="" Click="RefreshScreenOptions_Click" />
                                    <Button x:Name="BtnScreensReset" Content="" Click="ResetScreenDefaults_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="TxtMultiScreenHint"
                                Text=""
                                Margin="0,0,0,12"
                                Style="{StaticResource BasCaptionStyle}" />
                            <StackPanel
                                x:Name="PanelScreenOptions"
                                Spacing="0" />
                        </StackPanel>

                        <!-- 「更多设置」已移除：仅有的侧边栏背景图功能不再提供。 -->

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 日志 ===== -->
            <Grid x:Name="PageLog" Visibility="Collapsed" Padding="28,20,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLogTitle"
                                   Grid.Column="0"
                                   Text=""
                                   Style="{StaticResource BasSettingsPageTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnClearLog"
                                Grid.Column="1"
                                Content=""
                                Click="ClearLog_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TxtLogHint"
                               Text=""
                               Margin="0,6,0,0"
                               Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource BasCardStyle}" Margin="0">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtAppLog"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource BasFontSizeCaption}" FontFamily="Consolas" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 关于 ===== -->
            <ScrollViewer x:Name="PageAbout"
                          Visibility="Collapsed"
                          Padding="28,20,28,28"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtAboutTitle" Text="" Style="{StaticResource BasSettingsPageTitleStyle}" />

                    <Border Style="{StaticResource BasSettingCardStyle}" Margin="0,16,0,6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="BASpark" Style="{StaticResource BasSettingTitleStyle}" />
                                <TextBlock x:Name="TxtAboutDescription" Text="" Style="{StaticResource BasCaptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="AboutVersionText" Grid.Column="1" Text="—"
                                       Style="{StaticResource BasSettingTitleStyle}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtRepositoryLinks" Text="" Style="{StaticResource BasSettingsSectionTitleStyle}"
                               Margin="0,20,0,8" />
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Tag, ElementName=BtnRepoDoomVoss}" Style="{StaticResource BasSettingTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnRepoDoomVoss" Grid.Column="1" Content="" Tag="https://github.com/DoomVoss/BASpark"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Tag, ElementName=BtnRepoCialloKing}" Style="{StaticResource BasSettingTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnRepoCialloKing" Grid.Column="1" Content="" Tag="https://github.com/CialloKing/BASpark"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BasSettingCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Tag, ElementName=BtnRepoWinUI}" Style="{StaticResource BasSettingTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnRepoWinUI" Grid.Column="1" Content="" Tag="https://github.com/Hdy08/BASpark/tree/WinUI3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRepository_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>

        <!-- ==================== 模态层 ==================== -->

        <!-- 运行中进程选择 -->
        <Grid x:Name="RunningProcessOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="520"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayRunning"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchRunningProcess"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             PlaceholderText=""
                             TextChanged="SearchRunningProcess_TextChanged" />
                    <ListView x:Name="ListRunningProcesses" Grid.Row="2" SelectionMode="None"
                              MinHeight="240" Margin="0,0,-16,0" HorizontalContentAlignment="Stretch"
                              ItemTemplateSelector="{StaticResource SelectionCardTemplates}"
                              ItemContainerStyle="{StaticResource SelectionCardContainerStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel CacheLength="2" /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayCancel"
                                Content=""
                                Click="CloseRunningProcessOverlay_Click" />
                        <Button x:Name="BtnOverlayConfirmAdd"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmAddRunningProcesses_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 视觉表现恢复默认 -->
        <Grid x:Name="VisualResetOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="560"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayVisualReset"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchVisualReset"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             TextChanged="SearchVisualReset_TextChanged" />
                    <ListView x:Name="ListVisualResetItems" Grid.Row="2" SelectionMode="None"
                              MinHeight="260" Margin="0,0,-16,0" HorizontalContentAlignment="Stretch"
                              ItemTemplateSelector="{StaticResource SelectionCardTemplates}"
                              ItemContainerStyle="{StaticResource SelectionCardContainerStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel CacheLength="2" /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayVisualCancel"
                                Content=""
                                Click="CloseVisualResetOverlay_Click" />
                        <Button x:Name="BtnOverlayVisualConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmVisualReset_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 配置组重命名 -->
        <Grid x:Name="RenameProfileOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="380"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="NewProfileNameInput" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayRenameCancel"
                                Content=""
                                Click="CloseRenameOverlay_Click" />
                        <Button x:Name="BtnOverlayRenameConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmRenameProfile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>
    </Grid>
</UserControl>
