<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BASpark.ControlPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 原生标题栏 ==================== -->
        <!-- 使用 WinUI 原生 TitleBar 控件；窗口已 ExtendsContentIntoTitleBar，
             系统标题栏不再绘制。 -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title=""
                  Subtitle=""
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False" />

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 侧边栏 ==================== -->
        <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource BasSidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自定义背景图铺在最底层 -->
            <Border x:Name="SidebarBackgroundHost" Grid.RowSpan="2" />

            <!--
                所有主标签放在同一个 StackPanel 内，子导航作为「设置」的直接后继。
                这样折叠时不会在「设置」与「日志」之间留下跨容器的固定间距。
            -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,12,8,8">
                <StackPanel Spacing="2">
                    <RadioButton x:Name="TabWelcome"
                                 GroupName="MainNav"
                                 IsChecked="True"
                                 Style="{StaticResource BasNavRadioStyle}"
                                 Click="Tab_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock x:Name="TabWelcomeLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabSettings"
                                 GroupName="MainNav"
                                 Style="{StaticResource BasNavRadioStyle}"
                                 Click="Tab_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock x:Name="TabSettingsLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!--
                        设置子导航：容器高度由 SubNavAnimator 做「依赖动画」+ 裁剪，
                        高度逐帧变化，下面的「日志 / 关于」贴着展开边缘被连续推开。
                        不用原生 Expander：实测它不做布局动画（下方导航项在一帧内整段
                        位移 168px），而在它外面套高度动画会破坏它自己的内容定位与裁剪
                        （动画中途子项会跳到错误的行、甚至整段消失）。
                    -->
                    <Border x:Name="SettingsSubNavHost"
                            Margin="0"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                        <StackPanel x:Name="SettingsSubNav" Spacing="2">
                            <RadioButton x:Name="SubTabBasic"
                                         GroupName="SettingsNav"
                                         IsChecked="True"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabBasicLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabVisual"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabVisualLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabFilter"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabFilterLabel" />
                            </RadioButton>
                            <RadioButton x:Name="SubTabMultiScreen"
                                         GroupName="SettingsNav"
                                         Style="{StaticResource BasSubNavRadioStyle}"
                                         Click="SubTab_Click">
                                <TextBlock x:Name="SubTabMultiScreenLabel" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!--
                        「日志 / 关于」单独成组：设置子导航展开/收起时，这一组靠独立的
                        平移动画（合成器线程插值，按屏幕刷新率更新）被连续推开，
                        容器自身的布局高度只在切换的那一刻改一次，因此不会掉帧。
                    -->
                    <StackPanel x:Name="NavAfterSettings" Spacing="2">
                        <RadioButton x:Name="TabLog"
                                     GroupName="MainNav"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                <TextBlock x:Name="TabLogLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabAbout"
                                     GroupName="MainNav"
                                     Style="{StaticResource BasNavRadioStyle}"
                                     Click="Tab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <TextBlock x:Name="TabAboutLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="12,8,12,14" Spacing="2">
                <TextBlock x:Name="TxtSidebarVersion"
                           Text="BASpark"
                           FontSize="{StaticResource BasFontSizeCaption}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource BasTextTertiaryBrush}" />
                <TextBlock x:Name="TxtSidebarCopyright"
                           Text=""
                           FontSize="{StaticResource BasFontSizeCaption}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource BasTextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Background="{ThemeResource BasSidebarBorderBrush}" />

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Column="1">

            <!-- ===== 首页 ===== -->
            <ScrollViewer x:Name="PageWelcome"
                          Padding="{StaticResource BasPagePadding}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtWelcomeTitle"
                               Text=""
                               Style="{StaticResource BasPageTitleStyle}" />
                    <TextBlock x:Name="TxtWelcomeSubtitle"
                               Text=""
                               Margin="0,4,0,24"
                               Style="{StaticResource BasPageSubtitleStyle}" />

                    <!-- 实时统计 -->
                    <Border Style="{StaticResource BasCardStyle}" HorizontalAlignment="Left" MinWidth="360">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatsTitle"
                                       Text=""
                                       Style="{StaticResource BasSectionTitleStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <Grid Margin="0,16,0,0">
                                <TextBlock x:Name="TxtStatusLabel"
                                           Text=""
                                           Foreground="{ThemeResource BasTextSecondaryBrush}" />
                                <TextBlock x:Name="StatusText"
                                           Text="—"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="TxtClicksLabel"
                                           Text=""
                                           VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource BasTextSecondaryBrush}" />
                                <TextBlock x:Name="ClickCountText"
                                           Text="0"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource BasFontSizeSubtitle}"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 设置 ===== -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页头：标题 + 应用按钮 -->
                <Grid Grid.Row="0" Padding="28,24,28,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSettingsTitle"
                                   Text=""
                                   Style="{StaticResource BasPageTitleStyle}" />
                        <TextBlock x:Name="TxtSettingsHint"
                                   Text=""
                                   Margin="0,4,0,0"
                                   Style="{StaticResource BasCaptionStyle}"
                                   Foreground="{ThemeResource BasCautionBrush}" />
                    </StackPanel>

                    <Button x:Name="BtnApplySettings"
                            Grid.Column="1"
                            Content=""
                            Click="SaveSettings_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="128"
                            VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="0"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource BasDividerBrush}" />

                <ScrollViewer x:Name="SettingsContentScrollViewer"
                              Grid.Row="1"
                              Padding="28,16,28,28"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ===== 基础设置 ===== -->
                        <StackPanel x:Name="SectionBasic">
                            <Border Style="{StaticResource BasCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBasicTitle"
                                               Text=""
                                               Style="{StaticResource BasSectionTitleStyle}" />

                                    <TextBlock x:Name="TxtBasicLanguage"
                                               Text=""
                                               Margin="0,16,0,6"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <ComboBox x:Name="ComboLanguage"
                                              MinWidth="240"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="ComboLanguage_SelectionChanged" />

                                    <TextBlock x:Name="TxtDarkMode"
                                               Text=""
                                               Margin="0,20,0,6"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <RadioButtons x:Name="RadioDarkMode" MaxColumns="3">
                                        <RadioButton x:Name="RadioDarkModeOff" Content="" />
                                        <RadioButton x:Name="RadioDarkModeOn" Content="" />
                                        <RadioButton x:Name="RadioDarkModeSystem" Content="" IsChecked="True" />
                                    </RadioButtons>

                                    <TextBlock x:Name="TxtBasicNetworkRegion"
                                               Text=""
                                               Margin="0,20,0,6"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <RadioButtons x:Name="RadioNetworkRegion" MaxColumns="3">
                                        <RadioButton x:Name="RadioNetworkRegionAuto" Content="" IsChecked="True" />
                                        <RadioButton x:Name="RadioNetworkRegionChina" Content="" />
                                        <RadioButton x:Name="RadioNetworkRegionGlobal" Content="" />
                                    </RadioButtons>
                                    <TextBlock x:Name="TxtNetworkRegionHint"
                                               Text=""
                                               Margin="0,8,0,0"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <TextBlock x:Name="TxtScrollbarVisibility"
                                               Text=""
                                               Margin="0,20,0,6"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <RadioButtons x:Name="RadioScrollbarVisibility" MaxColumns="2">
                                        <RadioButton x:Name="RadioScrollbarAlways" Content="" />
                                        <RadioButton x:Name="RadioScrollbarOnScroll" Content="" IsChecked="True" />
                                    </RadioButtons>
                                    <TextBlock x:Name="TxtScrollbarHint"
                                               Text=""
                                               Margin="0,8,0,0"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,20,0,12" />

                                    <ToggleSwitch x:Name="CheckAlwaysTrailEffectSwitch"
                                                  Header=""
                                                  Margin="0,0,0,8" />
                                    <ToggleSwitch x:Name="CheckMasterSwitch"
                                                  Header=""
                                                  Margin="0,0,0,8"
                                                  Toggled="CheckMasterSwitch_Changed" />

                                    <StackPanel x:Name="PanelClickEffectOptions" Margin="0,8,0,8">
                                        <TextBlock x:Name="TxtClickType"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <RadioButtons x:Name="RadioClickType" MaxColumns="3">
                                            <RadioButton Name="RadioLeftClick" Content="" IsChecked="True" />
                                            <RadioButton Name="RadioRightClick" Content="" />
                                            <RadioButton Name="RadioBothClick" Content="" />
                                        </RadioButtons>
                                        <ToggleSwitch x:Name="CheckMiddleClickTrigger"
                                                      Header=""
                                                      Margin="0,12,0,0" />
                                    </StackPanel>

                                    <ToggleSwitch x:Name="CheckScreenshotCompatibilityMode"
                                                  Header=""
                                                  Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtScreenshotHint"
                                               Text=""
                                               Margin="0,0,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <ToggleSwitch x:Name="CheckAutoStart"
                                                  Header=""
                                                  Margin="0,0,0,8" />
                                    <ToggleSwitch x:Name="CheckStartSilent"
                                                  Header=""
                                                  Margin="0,0,0,8" />
                                    <ToggleSwitch x:Name="CheckRunAsAdmin"
                                                  Header=""
                                                  Margin="0,0,0,4"
                                                  Toggled="CheckRunAsAdmin_Changed" />
                                    <TextBlock x:Name="TxtRunAsAdminHint"
                                               Text=""
                                               Margin="0,0,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <ToggleSwitch x:Name="CheckTouchscreenMode"
                                                  Header=""
                                                  Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtTouchscreenHint"
                                               Text=""
                                               Margin="0,0,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 视觉表现 ===== -->
                        <StackPanel x:Name="SectionVisual" Visibility="Collapsed">
                            <Border Style="{StaticResource BasCardStyle}">
                                <StackPanel>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtVisualTitle"
                                                   Grid.Column="0"
                                                   Text=""
                                                   Style="{StaticResource BasSectionTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="BtnVisualReset"
                                                Grid.Column="1"
                                                Content=""
                                                Click="OpenVisualResetOverlay_Click" />
                                    </Grid>

                                    <TextBlock x:Name="TxtVisualInputHint"
                                               Text=""
                                               Margin="0,8,0,0"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <ToggleSwitch x:Name="CheckLinkedEffectScale"
                                                  Header=""
                                                  Margin="0,16,0,0"
                                                  Toggled="LinkedEffectScale_Changed" />
                                    <TextBlock x:Name="TxtLinkedScaleHint"
                                               Text=""
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <StackPanel x:Name="PanelUnifiedEffectScale" Margin="0,16,0,0">
                                        <TextBlock x:Name="TxtVisualScale"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderScale"
                                                    Grid.Column="0"
                                                    Minimum="0.5" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtScaleValue"
                                                       Grid.Column="1"
                                                       Minimum="0.5" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelSplitEffectScale" Margin="0,16,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtTrailScale"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderTrailScale"
                                                    Grid.Column="0"
                                                    Minimum="0.5" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtTrailScaleValue"
                                                       Grid.Column="1"
                                                       Minimum="0.5" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>

                                        <TextBlock x:Name="TxtClickScale"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderClickScale"
                                                    Grid.Column="0"
                                                    Minimum="0.5" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtClickScaleValue"
                                                       Grid.Column="1"
                                                       Minimum="0.5" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtVisualOpacity"
                                               Text=""
                                               Margin="0,20,0,0"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderOpacity"
                                                Grid.Column="0"
                                                Minimum="10" Maximum="100"
                                                StepFrequency="5"
                                                ValueChanged="EffectSlider_ValueChanged" />
                                        <NumberBox x:Name="TxtOpacityValue"
                                                   Grid.Column="1"
                                                   Minimum="10" Maximum="100"
                                                   SmallChange="5"
                                                   SpinButtonPlacementMode="Compact"
                                                   Width="120"
                                                   ValueChanged="EffectNumberBox_ValueChanged" />
                                    </Grid>

                                    <TextBlock x:Name="TxtGlowIntensity"
                                               Text=""
                                               Margin="0,20,0,0"
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderGlow"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="3"
                                                StepFrequency="0.1"
                                                ValueChanged="EffectSlider_ValueChanged" />
                                        <NumberBox x:Name="TxtGlowValue"
                                                   Grid.Column="1"
                                                   Minimum="0" Maximum="3"
                                                   SmallChange="0.1"
                                                   SpinButtonPlacementMode="Compact"
                                                   Width="120"
                                                   ValueChanged="EffectNumberBox_ValueChanged" />
                                    </Grid>

                                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,20,0,12" />

                                    <ToggleSwitch x:Name="CheckLinkedAnimationSpeed"
                                                  Header=""
                                                  Toggled="LinkedAnimationSpeed_Changed" />
                                    <TextBlock x:Name="TxtLinkedSpeedHint"
                                               Text=""
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <StackPanel x:Name="PanelUnifiedAnimationSpeed" Margin="0,16,0,0">
                                        <TextBlock x:Name="TxtAnimSpeed"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderSpeed"
                                                    Grid.Column="0"
                                                    Minimum="0.2" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtSpeedValue"
                                                       Grid.Column="1"
                                                       Minimum="0.2" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelSplitAnimationSpeed" Margin="0,16,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtTrailAnimSpeed"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderTrailAnimSpeed"
                                                    Grid.Column="0"
                                                    Minimum="0.2" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtTrailSpeedValue"
                                                       Grid.Column="1"
                                                       Minimum="0.2" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>

                                        <TextBlock x:Name="TxtClickAnimSpeed"
                                                   Text=""
                                                   Style="{StaticResource BasFieldLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderClickAnimSpeed"
                                                    Grid.Column="0"
                                                    Minimum="0.2" Maximum="3.0"
                                                    StepFrequency="0.1"
                                                    ValueChanged="EffectSlider_ValueChanged" />
                                            <NumberBox x:Name="TxtClickSpeedValue"
                                                       Grid.Column="1"
                                                       Minimum="0.2" Maximum="3.0"
                                                       SmallChange="0.1"
                                                       SpinButtonPlacementMode="Compact"
                                                       Width="120"
                                                       ValueChanged="EffectNumberBox_ValueChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,20,0,12" />

                                    <ToggleSwitch x:Name="CheckApplyCurveDraw"
                                                  Header=""
                                                  Toggled="CurveDraw_Changed" />
                                    <TextBlock x:Name="TxtCurveDrawHint"
                                               Text=""
                                               Margin="0,0,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <ToggleSwitch x:Name="CheckFollowDisplayRefreshRate"
                                                  Header="" />
                                    <TextBlock x:Name="TxtFollowDisplayRefreshRateHint"
                                               Text=""
                                               Margin="0,0,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />

                                    <TextBlock x:Name="TxtTrailRefresh"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderTrailRefresh"
                                                Grid.Column="0"
                                                Minimum="30" Maximum="360"
                                                StepFrequency="1" />
                                        <NumberBox x:Name="TxtTrailRefreshValue"
                                                   Grid.Column="1"
                                                   Minimum="30" Maximum="360"
                                                   SmallChange="1"
                                                   SpinButtonPlacementMode="Compact"
                                                   Width="120" />
                                    </Grid>

                                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,20,0,12" />

                                    <TextBlock x:Name="TxtEffectColor"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border x:Name="ColorPreview"
                                                Width="48" Height="32"
                                                CornerRadius="{StaticResource BasControlCornerRadius}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource BasControlStrokeBrush}" />
                                        <Button x:Name="BtnPickColor"
                                                Content=""
                                                Click="PickColor_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 环境过滤 ===== -->
                        <StackPanel x:Name="SectionFilter" Visibility="Collapsed">
                            <Border Style="{StaticResource BasCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtFilterTitle"
                                               Text=""
                                               Style="{StaticResource BasSectionTitleStyle}" />

                                    <ToggleSwitch x:Name="CheckEnvironmentFilter"
                                                  Header=""
                                                  Margin="0,16,0,0"
                                                  Toggled="EnvironmentFilterSetting_Changed" />
                                    <ToggleSwitch x:Name="CheckHideInFullscreen"
                                                  Header=""
                                                  Margin="0,0,0,8" />
                                    <ToggleSwitch x:Name="CheckShowEffectOnDesktop"
                                                  Header="" />

                                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,20,0,12" />

                                    <!-- 配置组 -->
                                    <TextBlock x:Name="TxtFilterProfiles"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <ComboBox x:Name="ComboProfiles"
                                                  MinWidth="220"
                                                  SelectionChanged="ComboProfiles_SelectionChanged" />
                                        <Button x:Name="BtnAddProfile"
                                                Content=""
                                                Click="AddProfile_Click" />
                                        <Button x:Name="BtnRenameProfile"
                                                Content=""
                                                Click="RenameProfile_Click" />
                                        <Button x:Name="BtnDeleteProfile"
                                                Content=""
                                                Style="{StaticResource BasDangerButtonStyle}"
                                                Click="DeleteProfile_Click" />
                                    </StackPanel>

                                    <TextBlock x:Name="TxtFilterMode"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <ComboBox x:Name="ComboProcessFilterMode"
                                              MinWidth="220"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,16"
                                              SelectionChanged="ProcessFilterMode_Changed">
                                        <ComboBoxItem Content="" />
                                        <ComboBoxItem Content="" />
                                        <ComboBoxItem Content="" />
                                    </ComboBox>

                                    <TextBlock x:Name="TxtProcessList"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <ListView x:Name="ListConfiguredProcesses"
                                              MaxHeight="200"
                                              SelectionMode="None"
                                              Margin="0,0,0,12">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Click="RemoveProcess_Click"
                                                            Tag="{Binding}"
                                                            Padding="8,2">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock x:Name="TxtAddProcess"
                                               Text=""
                                               Style="{StaticResource BasFieldLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="ManualProcessInput"
                                                 MinWidth="240"
                                                 PlaceholderText="notepad.exe" />
                                        <Button x:Name="BtnAddProcess"
                                                Content=""
                                                Click="AddManualProcess_Click" />
                                        <Button x:Name="BtnBrowseProcess"
                                                Content=""
                                                Click="BrowseProcess_Click" />
                                        <Button x:Name="BtnSelectRunningProcess"
                                                Content=""
                                                Click="SelectRunningProcess_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 多屏管理 ===== -->
                        <StackPanel x:Name="SectionMultiScreen" Visibility="Collapsed">
                            <Border Style="{StaticResource BasCardStyle}">
                                <StackPanel>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtMultiScreenTitle"
                                                   Grid.Column="0"
                                                   Text=""
                                                   Style="{StaticResource BasSectionTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="BtnRefreshScreens"
                                                Grid.Column="1"
                                                Content=""
                                                Click="RefreshScreenOptions_Click" />
                                    </Grid>
                                    <TextBlock x:Name="TxtMultiScreenHint"
                                               Text=""
                                               Margin="0,8,0,12"
                                               Style="{StaticResource BasCaptionStyle}" />
                                    <StackPanel x:Name="PanelScreenOptions" Spacing="4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 「更多设置」已移除：仅有的侧边栏背景图功能不再提供。 -->

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 日志 ===== -->
            <Grid x:Name="PageLog" Visibility="Collapsed" Padding="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLogTitle"
                                   Grid.Column="0"
                                   Text=""
                                   Style="{StaticResource BasPageTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnClearLog"
                                Grid.Column="1"
                                Content=""
                                Click="ClearLog_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TxtLogHint"
                               Text=""
                               Margin="0,6,0,0"
                               Style="{StaticResource BasCaptionStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource BasCardStyle}" Margin="0">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtAppLog"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="{StaticResource BasFontSizeCaption}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 关于 ===== -->
            <ScrollViewer x:Name="PageAbout"
                          Visibility="Collapsed"
                          Padding="28"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtAboutTitle"
                               Text=""
                               Style="{StaticResource BasPageTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BASpark"
                                   FontSize="{StaticResource BasFontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutVersionText"
                                   Text="—"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource BasTextSecondaryBrush}" />
                        <Button x:Name="BtnCheckUpdate"
                                Content=""
                                Click="CheckUpdate_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtAboutDescription"
                               Text=""
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource BasTextSecondaryBrush}" />

                    <InfoBar x:Name="SecurityWarningBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Margin="0,16,0,0">
                        <InfoBar.Content>
                            <TextBlock x:Name="TxtSecurityWarning"
                                       Text=""
                                       TextWrapping="Wrap" />
                        </InfoBar.Content>
                    </InfoBar>

                    <TextBlock x:Name="TxtAboutSupport"
                               Text=""
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <StackPanel x:Name="PanelLinks" Margin="0,16,0,0" Spacing="8" MaxWidth="280" HorizontalAlignment="Left">
                        <Button x:Name="BtnOfficialSite"
                                Tag="https://www.baspark.top"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                        <Button x:Name="BtnGithub"
                                Tag="https://github.com/DoomVoss/BASpark"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                        <Button x:Name="BtnBilibili"
                                Tag="https://space.bilibili.com/3493116084488813"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                        <Button x:Name="BtnQQ"
                                Tag="https://qm.qq.com/q/lgvVto3yPm"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                        <Button x:Name="BtnDiscord"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                        <Button x:Name="BtnSponsor"
                                Tag="https://afdian.com/a/doomvoss"
                                Click="OpenLink_Click"
                                Style="{StaticResource BasLinkButtonStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource BasDividerStyle}" Margin="0,24,0,12" />

                    <TextBlock x:Name="TxtDevOptions"
                               Text=""
                               Style="{StaticResource BasFieldLabelStyle}"
                               Foreground="{ThemeResource BasTextTertiaryBrush}" />
                    <Button x:Name="BtnResetAll"
                            Content=""
                            Style="{StaticResource BasDangerButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="ResetConfig_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 模态层 ==================== -->

        <!-- 运行中进程选择 -->
        <Grid x:Name="RunningProcessOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="520"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayRunning"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchRunningProcess"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             PlaceholderText=""
                             TextChanged="SearchRunningProcess_TextChanged" />
                    <ListView x:Name="ListRunningProcesses"
                              Grid.Row="2"
                              SelectionMode="Multiple"
                              MinHeight="240" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayCancel"
                                Content=""
                                Click="CloseRunningProcessOverlay_Click" />
                        <Button x:Name="BtnOverlayConfirmAdd"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmAddRunningProcesses_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 视觉表现恢复默认 -->
        <Grid x:Name="VisualResetOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="420"
                    MaxHeight="560"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtOverlayVisualReset"
                               Grid.Row="0"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBox x:Name="SearchVisualReset"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             TextChanged="SearchVisualReset_TextChanged" />
                    <ListView x:Name="ListVisualResetItems"
                              Grid.Row="2"
                              SelectionMode="None"
                              MinHeight="260" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayVisualCancel"
                                Content=""
                                Click="CloseVisualResetOverlay_Click" />
                        <Button x:Name="BtnOverlayVisualConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmVisualReset_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 配置组重命名 -->
        <Grid x:Name="RenameProfileOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource BasModalScrimBrush}">
            <Border Style="{StaticResource BasModalCardStyle}"
                    Width="380"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtOverlayRename"
                               Text=""
                               Style="{StaticResource BasSectionTitleStyle}" />
                    <TextBlock x:Name="TxtOverlayRenamePrompt"
                               Text=""
                               Margin="0,8,0,12"
                               Style="{StaticResource BasCaptionStyle}" />
                    <TextBox x:Name="NewProfileNameInput" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnOverlayRenameCancel"
                                Content=""
                                Click="CloseRenameOverlay_Click" />
                        <Button x:Name="BtnOverlayRenameConfirm"
                                Content=""
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConfirmRenameProfile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        </Grid>
    </Grid>
</Window>
