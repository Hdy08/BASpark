                            </Grid>
                            <Grid>
                                <TextBlock x:Name="TxtClicksLabel" Text="累计点击次数:" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                                <TextBlock x:Name="ClickCountText" Text="0 次" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Name="PageAbout" Visibility="Collapsed">
                    <TextBlock x:Name="TxtAboutTitle" Text="关于" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" VerticalAlignment="Center">
                            <Run Text="BASpark "/>
                            <Run x:Name="VersionText" Text="V1.6.2" Foreground="#45AFFF" FontSize="24"/>
                        </TextBlock>
                        <Button x:Name="BtnCheckUpdate" Content="检查更新" Click="CheckUpdate_Click" Margin="18,0,0,0" Padding="12,3" Height="30" FontSize="12" Background="{DynamicResource ThemeUpdateButtonBackgroundBrush}" Foreground="#45AFFF" BorderBrush="#45AFFF" BorderThickness="1" Cursor="Hand" Style="{DynamicResource SecondaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="TxtAboutDescription" Text="深度复刻《蔚蓝档案》UI 风格动效的鼠标特效工具" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Border Background="{DynamicResource ThemeDangerButtonBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,20" BorderBrush="{DynamicResource ThemeDangerButtonBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SecurityWarningIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ThemeWarningIconBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="TxtSecurityWarning" Text="安全提示：请务必确保从官方渠道下载。第三方分发渠道的版本可能存在报毒风险或恶意篡改。" Foreground="{DynamicResource ThemeDangerButtonForegroundBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtAboutSupport" Text="如果你喜欢本应用，欢迎支持开发者持续维护 ☕" Foreground="#45AFFF" Margin="0,0,0,25"/>
                    
                    <Button x:Name="BtnOfficialSite" Click="OpenLink_Click" Width="220" Height="38" Background="#45AFFF" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10" Style="{DynamicResource PrimaryActionButton}"/>
                    <Button x:Name="BtnGithub" Tag="https://github.com/DoomVoss/BASpark" Click="OpenLink_Click" Width="220" Height="38" Background="#333" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button x:Name="BtnBilibili" Tag="https://space.bilibili.com/3493116084488813" Click="OpenLink_Click" Width="220" Height="38" Background="#FB7299" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button x:Name="BtnQQ" Tag="https://qm.qq.com/q/lgvVto3yPm" Click="OpenLink_Click" Width="220" Height="38" Background="#12B7F5" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button x:Name="BtnDiscord" Click="OpenLink_Click" Width="220" Height="38" Background="#5865F2" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button x:Name="BtnSponsor" Tag="https://afdian.com/a/doomvoss" Click="OpenLink_Click" Width="220" Height="38" Background="#FF8140" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,30"/>

                    <TextBlock x:Name="TxtDevOptions" Text="开发者选项" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,15,0,10"/>
                    <Button x:Name="BtnResetAll" Content="重置所有设置并退出" Click="ResetConfig_Click" Background="{DynamicResource ThemeDangerStrongBackgroundBrush}" Foreground="{DynamicResource ThemeDangerButtonForegroundBrush}" BorderThickness="0" HorizontalAlignment="Left" Padding="15,8" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Name="PageLog" Visibility="Collapsed">
                    <TextBlock x:Name="TxtLogTitle" Text="运行日志" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLogHint" Text="实时显示软件运行状态与错误信息。" FontSize="12" Foreground="{DynamicResource ThemeLogHintBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <Button x:Name="BtnClearLog" Content="清空日志" Click="ClearLog_Click" DockPanel.Dock="Right" Padding="12,4" Height="30" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Cursor="Hand" Style="{DynamicResource SecondaryActionButton}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </DockPanel>
                    <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TextBox x:Name="TxtAppLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Courier New" FontSize="12" Foreground="{DynamicResource ThemePrimaryTextBrush}" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                </Grid>
            </ScrollViewer>

            <Grid x:Name="PageSettings" Visibility="Collapsed" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="SettingsHeaderBackground" Grid.Row="0" Background="{DynamicResource ThemePageBackgroundBrush}" Padding="0,0,0,16">
                    <Border BorderBrush="{DynamicResource ThemeSettingsDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSettingsTitle" Text="参数配置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryTextBrush}"/>
                                <TextBlock x:Name="TxtSettingsHint" Text="*修改设置后，请点击右侧 [应用更改] 按钮生效。" FontSize="11" Foreground="#FF6B6B" FontWeight="SemiBold" Margin="0,4,0,0" Opacity="0.9"/>
                            </StackPanel>
                            <Button x:Name="BtnApplySettings" Grid.Column="1" Content="应用更改" Click="SaveSettings_Click" Width="120" Height="36" Background="#45AFFF" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14" Style="{DynamicResource PrimaryActionButton}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15"/>
                                </Button.Effect>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="SettingsContentScrollViewer_ScrollChanged"
                              PreviewMouseWheel="SettingsContentScrollViewer_PreviewMouseWheel">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SubTabBasic}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBasicTitle" Text="基础设置" FontSize="14" FontWeight="Bold" Foreground="#45AFFF" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtBasicLanguage" Text="界面语言" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                        <ComboBox x:Name="ComboLanguage" Width="220" HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtDarkMode" Text="深色模式" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                        <Border Background="{DynamicResource ThemeSubtleBackgroundBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RadioDarkModeOff" Content="关闭" GroupName="DarkMode" Width="72" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton x:Name="RadioDarkModeOn" Content="开启" GroupName="DarkMode" Width="72" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton x:Name="RadioDarkModeSystem" Content="跟随系统" GroupName="DarkMode" IsChecked="True" Width="120" Style="{StaticResource SegmentBtn}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtBasicNetworkRegion" Text="网络源" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                        <Border Background="{DynamicResource ThemeSubtleBackgroundBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RadioNetworkRegionAuto" Content="跟随语言" GroupName="NetworkRegion" IsChecked="True" Width="96" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton x:Name="RadioNetworkRegionChina" Content="中国大陆" GroupName="NetworkRegion" Width="96" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton x:Name="RadioNetworkRegionGlobal" Content="全球" GroupName="NetworkRegion" Width="72" Style="{StaticResource SegmentBtn}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtNetworkRegionHint" Text="* 用于获取公告与检查更新；默认跟随界面语言自动选择。" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtScrollbarVisibility" Text="滚动条显示" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                        <Border Background="{DynamicResource ThemeSubtleBackgroundBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RadioScrollbarAlways" Content="常驻显示" GroupName="ScrollbarVisibility" Width="88" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton x:Name="RadioScrollbarOnScroll" Content="仅滚动时显示" GroupName="ScrollbarVisibility" IsChecked="True" Width="120" Style="{StaticResource SegmentBtn}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtScrollbarHint" Text="* 控制面板滚动条较细；仅滚动时显示可减少调整窗口大小时滚动条反复出现/消失的视觉割裂。" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"/>
                                    </StackPanel>
                                    <CheckBox Name="CheckAlwaysTrailEffectSwitch" Content="启用鼠标常驻拖尾" Style="{StaticResource ToggleSwitch}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox Name="CheckMasterSwitch" Content="启用鼠标点击特效" Style="{StaticResource ToggleSwitch}" FontWeight="SemiBold" Margin="0,0,0,12" Checked="CheckMasterSwitch_Changed" Unchecked="CheckMasterSwitch_Changed"/>
                                    <StackPanel x:Name="PanelClickEffectOptions" Margin="0,0,0,15">
                                        <TextBlock x:Name="TxtClickType" Text="触发按键类型" Foreground="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,0,8" FontSize="12"/>
                                        <Border Background="{DynamicResource ThemeSubtleBackgroundBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Name="RadioLeftClick" Content="仅左键" GroupName="ClickType" IsChecked="True" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton Name="RadioRightClick" Content="仅右键" GroupName="ClickType" Style="{StaticResource SegmentBtn}"/>
                                                <RadioButton Name="RadioBothClick" Content="左右键" GroupName="ClickType" Style="{StaticResource SegmentBtn}"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Name="CheckMiddleClickTrigger" Content="鼠标中键按下时触发特效" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="CheckScreenshotCompatibilityMode" Content="截图兼容模式" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtScreenshotHint" Text="* (实验性功能) 开启后截图画面将不包含特效：检测到系统截图界面、QQ 默认截图快捷键 (Ctrl+Alt+A) 或微信截图快捷键 (Alt+A) 时会短暂隐藏叠加层以便框选窗口。" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" Margin="34,0,0,12" TextWrapping="Wrap" Opacity="0.8"/>
                                    <CheckBox Name="CheckAutoStart" Content="开机自动启动" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,8"/>
                                    <CheckBox Name="CheckStartSilent" Content="静默启动 (最小化到托盘)" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,8"/>
                                    <CheckBox Name="CheckRunAsAdmin" Content="以管理员权限运行程序" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,8" Checked="CheckRunAsAdmin_Changed" Unchecked="CheckRunAsAdmin_Changed"/>
                                    <TextBlock x:Name="TxtRunAsAdminHint" Text="* 若需在任务管理器等部分高权限窗口显示特效，请勾选此项。" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" Margin="34,0,0,10" TextWrapping="Wrap" Opacity="0.8"/>
                                    <CheckBox Name="CheckTouchscreenMode" Content="触摸屏模式" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtTouchscreenHint" Text="* 开启后，即便系统隐藏了鼠标指针特效依然生效，仅适用于触摸屏或特定的全屏应用环境。" FontSize="11" Foreground="{DynamicResource ThemeHintTextBrush}" Margin="34,0,0,12" TextWrapping="Wrap" Opacity="0.8"/>
                                    <CheckBox Name="CheckTelemetry" Content="允许发送匿名运行数据以改进软件" Style="{StaticResource ToggleSwitch}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

<StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=SubTabVisual}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border Background="{DynamicResource ThemeSurfaceBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                        <TextBlock x:Name="TxtVisualTitle" Text="视觉表现" FontSize="14" FontWeight="Bold" Foreground="#45AFFF" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                        <Button x:Name="BtnVisualReset" Content="恢复默认设置" Click="OpenVisualResetOverlay_Click" DockPanel.Dock="Right" Padding="10,4" Height="28" FontSize="12" Background="{DynamicResource ThemeButtonBackgroundBrush}" BorderBrush="{DynamicResource ThemeControlBorderBrush}" Cursor="Hand" VerticalAlignment="Center" Style="{DynamicResource SecondaryActionButton}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock x:Name="TxtVisualInputHint" Text="提示：可点击数字输入精确值后可按回车应用" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,0,8"/>

                                                    <StackPanel Margin="0,0,0,15">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtVisualScale" Text="缩放比例" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                         TextAlignment="Right" VerticalAlignment="Center" 
                                                                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                         Text="{Binding ElementName=SliderScale, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderScale" Minimum="0.5" Maximum="3.0" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,15">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtTrailThickness" Text="拖尾粗细" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                         TextAlignment="Right" VerticalAlignment="Center"
                                                                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                         Text="{Binding ElementName=SliderTrailThickness, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderTrailThickness" Minimum="0.5" Maximum="3.0" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,15">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtGlowIntensity" Text="发光强度" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                         TextAlignment="Right" VerticalAlignment="Center"
                                                                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                         Text="{Binding ElementName=SliderGlowIntensity, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                         PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"
                                                                         InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderGlowIntensity" Minimum="0.00" Maximum="3.00" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,15">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock x:Name="TxtVisualOpacity" Text="全局不透明度" Foreground="{DynamicResource ThemeTertiaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                <TextBox Width="40" Height="20" FontSize="12" Foreground="#45AFFF" FontWeight="Bold"
                                                                        TextAlignment="Right" VerticalAlignment="Center" 
                                                                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeNeutralBorderBrush}" Background="Transparent"
                                                                        Text="{Binding ElementName=SliderOpacity, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                        PreviewTextInput="NumberValidationTextBox" 
                                                                        KeyDown="TextBox_KeyDown"
                                                                        InputMethod.IsInputMethodEnabled="False"/>
                                                                <TextBlock Text="x" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Slider Name="SliderOpacity" Minimum="0.10" Maximum="1.00" TickFrequency="0.10" SmallChange="0.10" LargeChange="0.10" IsSnapToTickEnabled="True"
                                                                ValueChanged="EffectSlider_ValueChanged" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <CheckBox Name="CheckLinkedAnimationSpeed" Content="拖尾与点击使用同一动画速度" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"
