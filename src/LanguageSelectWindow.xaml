<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动的语言选择对话框（原生 WinUI 3 窗口）。

    文案在代码里按「系统检测到的语言」渲染（见 LanguageSelectWindow.ApplyLanguageText），
    勾选某个选项即预览该语言，点“继续”后才写回配置。
-->
<Window
    x:Class="BASpark.LanguageSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 使用 WinUI 原生 TitleBar 控件；窗口已 ExtendsContentIntoTitleBar，系统标题栏不再绘制。 -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title=""
                  Subtitle=""
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False" />

        <Border Grid.Row="1"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Padding="24,22">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TxtSubtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="32,20,32,0" Spacing="6">
            <RadioButton x:Name="RadioChinese"
                         GroupName="Lang"
                         Tag="zh-CN"
                         FontSize="15"
                         MinHeight="40"
                         Checked="LangOption_Checked" />
            <RadioButton x:Name="RadioEnglish"
                         GroupName="Lang"
                         Tag="en"
                         FontSize="15"
                         MinHeight="40"
                         Checked="LangOption_Checked" />
            <RadioButton x:Name="RadioJapanese"
                         GroupName="Lang"
                         Tag="ja"
                         FontSize="15"
                         MinHeight="40"
                         Checked="LangOption_Checked" />
        </StackPanel>

        <Border Grid.Row="3"
                BorderBrush="{ThemeResource BasDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Button x:Name="BtnContinue"
                    MinWidth="160"
                    MinHeight="40"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnContinue_Click" />
        </Border>
    </Grid>
</Window>
