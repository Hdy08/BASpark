<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动的语言选择对话框（原生 WinUI 3 窗口）。

    文案在代码里按「系统检测到的语言」渲染（见 LanguageSelectWindow.ApplyLanguageText），
    选择某个选项即预览该语言，点“继续”后才写回配置。
-->
<Window
    x:Class="BASpark.LanguageSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasSidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 使用 WinUI 原生 TitleBar 控件；窗口已 ExtendsContentIntoTitleBar，系统标题栏不再绘制。 -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Background="{ThemeResource BasSidebarBackgroundBrush}"
                  Title=""
                  Subtitle=""
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False" />

        <ScrollViewer Grid.Row="1" Margin="{StaticResource BasStartupContentMargin}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtSubtitle"
                           Style="{StaticResource BasSectionTitleStyle}" />
                <Border x:Name="LanguageCard" Style="{StaticResource BasSettingCardStyle}" Margin="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="*" MinWidth="140" MaxWidth="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLanguageLabel" Style="{StaticResource BasSettingTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ComboLanguage" Grid.Column="1" MinWidth="0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                  AutomationProperties.Name="{Binding Text, ElementName=TxtLanguageLabel}"
                                  SelectionChanged="ComboLanguage_SelectionChanged">
                            <ComboBoxItem x:Name="LanguageChinese" Tag="zh-CN" />
                            <ComboBoxItem x:Name="LanguageEnglish" Tag="en" />
                            <ComboBoxItem x:Name="LanguageJapanese" Tag="ja" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BasStartupActionBarStyle}">
            <Button x:Name="BtnContinue"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnContinue_Click" />
        </Border>
    </Grid>
</Window>
