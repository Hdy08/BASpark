<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动的语言选择对话框（原生 WinUI 3 窗口）。

    文案在代码里按「系统检测到的语言」渲染（见 LanguageSelectWindow.ApplyLanguageText），
    选择某个选项即预览该语言，点“继续”后才写回配置。
-->
<UserControl
    x:Class="BASpark.LanguageSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}">

    <Grid x:Name="RootGrid" Background="{ThemeResource BasSidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TitleBar x:Name="AppTitleBar" Grid.Column="0"
                      Background="{ThemeResource BasSidebarBackgroundBrush}"
                      Title="" Subtitle=""
                      IsBackButtonVisible="False" IsPaneToggleButtonVisible="False" />
            <Button x:Name="BtnCaptionClose" Grid.Column="1" Width="46" Height="32" Padding="0"
                    Background="#00E81123" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Top" Click="CaptionClose_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A2231A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="{StaticResource BasStartupContentMargin}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtSubtitle"
                           Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" />
                <Border x:Name="LanguageCard" Style="{StaticResource BasSettingCardStyle}" Margin="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLanguageLabel" Style="{StaticResource BasSettingTitleStyle}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <ComboBox x:Name="ComboLanguage" Grid.Column="1" MinWidth="0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" Padding="12,0,0,0"
                                  Background="{ThemeResource BasSettingsControlBackgroundBrush}"
                                  BorderBrush="{ThemeResource BasSettingsControlBorderBrush}"
                                  AutomationProperties.Name="{Binding Text, ElementName=TxtLanguageLabel}"
                                  SelectionChanged="ComboLanguage_SelectionChanged">
                            <ComboBoxItem x:Name="LanguageChinese" Tag="zh-CN" />
                            <ComboBoxItem x:Name="LanguageEnglish" Tag="en" />
                            <ComboBoxItem x:Name="LanguageJapanese" Tag="ja" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource BasStartupActionBarStyle}">
            <Button x:Name="BtnContinue"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnContinue_Click" />
        </Border>
    </Grid>
</UserControl>
