<?xml version="1.0" encoding="utf-8"?>
<!--
    BASpark 原生 WinUI 3 设计系统

    视觉语言完全建立在 Windows 11 / Fluent 之上：
      * Mica 作为窗口背景材质（见各自 Window 的 SystemBackdrop）
      * 内容承载在 CardBackgroundFillColorDefault 卡片上，配 CardStrokeColorDefault 描边
      * 控件一律使用 WinUI 内置模板（Button / ToggleSwitch / ComboBox / Slider /
        RadioButtons / InfoBar / Expander / NavigationView / ProgressRing），
        不再自绘任何控件模板
      * 文本层级使用 WinUI 标准字号（Caption 12 / Body 14 / BodyStrong 14 SemiBold /
        Subtitle 20 / Title 28）
      * 圆角统一 4 / 8（ControlCornerRadius / OverlayCornerRadius）

    主题切换依赖 ThemeDictionaries：同一套键名在 Light / Dark / HighContrast 下
    各给一份取值，由框架在 RequestedTheme 变化时自动解析。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BASpark"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ 浅色 ============================ -->
        <ResourceDictionary x:Key="Light">
            <!-- 页面与卡片层次 -->
            <SolidColorBrush x:Key="BasPageBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="BasLayerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BasCardBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="BasCardStrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="BasCardSecondaryBrush" Color="#80F9F9F9" />

            <!-- 侧边栏 -->
            <SolidColorBrush x:Key="BasSidebarBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="BasSettingsPageBackgroundBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="BasSettingsCardBackgroundBrush" Color="#FFFFFF" />
            <Color x:Key="BasSettingsCardColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="BasSettingsCardBorderBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BasSettingsControlBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="BasSettingsControlBorderBrush" Color="#D9D9D9" />
            <SolidColorBrush x:Key="BasNavigationSelectedBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="BasNavigationSelectedTextBrush" Color="#111111" />
            <StaticResource x:Key="BasSettingsAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="BasSettingsAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="BasSidebarBorderBrush" Color="#0F000000" />

            <!-- 文字层级（对齐 WinUI TextFillColor*） -->
            <SolidColorBrush x:Key="BasTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="BasTextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="BasTextTertiaryBrush" Color="#72000000" />
            <SolidColorBrush x:Key="BasTextDisabledBrush" Color="#5C000000" />

            <!-- 描边与分隔 -->
            <SolidColorBrush x:Key="BasStrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="BasDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="BasControlStrokeBrush" Color="#19000000" />

            <!-- 强调色（跟随系统强调色，AccentTextFillColorPrimaryBrush 用于文字） -->
            <SolidColorBrush x:Key="BasAccentSubtleBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.06" />
            <SolidColorBrush x:Key="BasAccentSubtleHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.15" />
            <SolidColorBrush x:Key="BasAccentSubtlePressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />

            <!-- 语义色 -->
            <SolidColorBrush x:Key="BasDangerousBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="BasDangerousSubtleBrush" Color="#0FC42B1C" />
            <SolidColorBrush x:Key="BasSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="BasCautionBrush" Color="#9D5D00" />

            <!-- 日志等只读代码区 -->
            <SolidColorBrush x:Key="BasCodeBackgroundBrush" Color="#FFF9F9F9" />

            <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="BasLayerBrush" />
        </ResourceDictionary>

        <!-- ============================ 深色 ============================ -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BasPageBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="BasLayerBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="BasCardBackgroundBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="BasCardStrokeBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="BasCardSecondaryBrush" Color="#0AFFFFFF" />

            <SolidColorBrush x:Key="BasSidebarBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="BasSettingsPageBackgroundBrush" Color="#272727" />
            <SolidColorBrush x:Key="BasSettingsCardBackgroundBrush" Color="#323232" />
            <Color x:Key="BasSettingsCardColor">#323232</Color>
            <SolidColorBrush x:Key="BasSettingsCardBorderBrush" Color="#323232" />
            <SolidColorBrush x:Key="BasSettingsControlBackgroundBrush" Color="#3E3E3E" />
            <SolidColorBrush x:Key="BasSettingsControlBorderBrush" Color="#505050" />
            <SolidColorBrush x:Key="BasNavigationSelectedBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="BasNavigationSelectedTextBrush" Color="#FFFFFF" />
            <StaticResource x:Key="BasSettingsAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="BasSettingsAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="BasSidebarBorderBrush" Color="#12FFFFFF" />

            <SolidColorBrush x:Key="BasTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="BasTextSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="BasTextTertiaryBrush" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="BasTextDisabledBrush" Color="#5DFFFFFF" />

            <SolidColorBrush x:Key="BasStrokeBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="BasDividerBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="BasControlStrokeBrush" Color="#18FFFFFF" />

            <SolidColorBrush x:Key="BasAccentSubtleBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="BasAccentSubtleHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.20" />
            <SolidColorBrush x:Key="BasAccentSubtlePressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />

            <SolidColorBrush x:Key="BasDangerousBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="BasDangerousSubtleBrush" Color="#1FC42B1C" />
            <SolidColorBrush x:Key="BasSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="BasCautionBrush" Color="#FCE100" />

            <SolidColorBrush x:Key="BasCodeBackgroundBrush" Color="#FF1F1F1F" />

            <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="BasLayerBrush" />
        </ResourceDictionary>

        <!-- ========================= 高对比度 ========================== -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BasPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasCardSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="BasSidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasSettingsPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasSettingsCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="BasSettingsCardColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="BasSettingsCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasSettingsControlBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasSettingsControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasNavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BasNavigationSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BasSettingsAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BasSettingsAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BasSidebarBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="BasTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasTextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="BasStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasControlStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="BasAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BasAccentSubtleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BasAccentSubtlePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="BasDangerousBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasDangerousSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BasSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BasCautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="BasCodeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="BasLayerBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== 排版与间距（与主题无关） ==================== -->

    <x:Double x:Key="BasCardCornerRadiusValue">8</x:Double>
    <CornerRadius x:Key="BasCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BasControlCornerRadius">4</CornerRadius>
    <Thickness x:Key="BasCardPadding">16</Thickness>
    <Thickness x:Key="BasPagePadding">28</Thickness>
    <Thickness x:Key="BasCardMargin">0,0,0,12</Thickness>
    <Thickness x:Key="ContentDialogPadding">16</Thickness>
    <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
    <Thickness x:Key="BasStartupContentMargin">24,20,24,0</Thickness>

    <StaticResource x:Key="BasFontSizeCaption" ResourceKey="CaptionTextBlockFontSize" />
    <StaticResource x:Key="BasFontSizeBody" ResourceKey="BodyTextBlockFontSize" />
    <StaticResource x:Key="BasFontSizeSubtitle" ResourceKey="SubtitleTextBlockFontSize" />
    <StaticResource x:Key="BasFontSizeTitle" ResourceKey="TitleTextBlockFontSize" />

    <!-- ==================== 可复用样式（全部基于 WinUI 默认模板） ==================== -->

    <!-- 页面主标题：Title 层级 -->
    <Style x:Key="BasPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
    </Style>

    <!-- 区块标题：Subtitle 层级 -->
    <Style x:Key="BasSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
    </Style>

    <Style x:Key="BasDialogMessageStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
    </Style>

    <!-- 说明文字：Caption 层级 -->
    <Style x:Key="BasCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextSecondaryBrush}" />
    </Style>

    <!-- 页头副标题 -->
    <Style x:Key="BasPageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextSecondaryBrush}" />
    </Style>

    <!-- 设置项标签 -->
    <Style x:Key="BasFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
    </Style>

    <!-- 分组卡片：Mica 之上的一层亚克力卡片 -->
    <Style x:Key="BasCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BasCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BasCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource BasCardPadding}" />
        <Setter Property="Margin" Value="{StaticResource BasCardMargin}" />
    </Style>

    <!--
        模态卡片：必须不透明。页面里的分组卡片用的是带 alpha 的画刷（在 Mica 上
        层次更细腻），但浮在内容之上的对话框若透出底下的文字会完全不可读。
    -->
    <Style x:Key="BasModalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BasLayerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BasCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource BasCardPadding}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BasContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Background" Value="{ThemeResource BasLayerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasControlStrokeBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BasCardCornerRadius}" />
    </Style>

    <Style x:Key="BasNativeDialogScrimStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource ContentDialogSmokeFill}" />
    </Style>

    <Style x:Key="BasStartupInfoBarStyle" TargetType="InfoBar">
        <Setter Property="IsOpen" Value="True" />
        <Setter Property="IsClosable" Value="False" />
        <Setter Property="IsIconVisible" Value="True" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BasRepositoryLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextDecorations="None" /></DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasNavigationIndicatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="20" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="Fill" Value="{ThemeResource BasSettingsAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="BasStartupActionBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,16,24,24" />
    </Style>

    <!-- 设置区块之间的细分隔线 -->
    <Style x:Key="BasDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource BasDividerBrush}" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <!-- 危险操作按钮（基于 WinUI 默认 Button 模板，只改配色） -->
    <Style x:Key="BasDangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource BasDangerousBrush}" />
        <Setter Property="Background" Value="{ThemeResource BasDangerousSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasDangerousBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BasControlCornerRadius}" />
    </Style>

    <!-- 关于页外链按钮 -->
    <Style x:Key="BasLinkButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{StaticResource BasControlCornerRadius}" />
    </Style>

    <!-- ==================== 侧边栏导航项 ==================== -->

    <Style x:Key="BasSettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BasPageTitleStyle}" />

    <Style x:Key="BasSettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="BasSettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource BasTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BasSettingCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BasSettingsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasSettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="60" />
    </Style>

    <Style x:Key="BasSettingToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Visibility="Collapsed" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasSegmentedSelectorStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BasSettingsControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BasSettingsControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BasSettingExpanderStyle" TargetType="Expander">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,0,16,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpandDirectionStates">
                                <VisualState x:Name="ExpandDown" />
                                <VisualState x:Name="CollapseDown" />
                                <VisualState x:Name="ExpandUp" />
                                <VisualState x:Name="CollapseUp" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ToggleButton x:Name="ExpanderHeader" Style="{StaticResource ExpanderHeaderDownStyle}"
                                      Background="{ThemeResource BasSettingsCardBackgroundBrush}" BorderThickness="0"
                                      MinHeight="{TemplateBinding MinHeight}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="ExpanderContentHost" Grid.Row="1" Height="0" IsHitTestVisible="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasColorPickerSliderStyle" TargetType="primitives:ColorPickerSlider">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ColorPickerSlider">
                    <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SliderContainer.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="VerticalTemplate">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="18" Fill="Transparent" />
                            <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Fill="Transparent" />
                            <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="20" Height="6"
                                   Background="Transparent" BorderBrush="White" BorderThickness="1"
                                   DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasColorPickerStyle" TargetType="ColorPicker">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPicker">
                    <Grid x:Name="LayoutRoot" Width="220" Height="164" ColumnSpacing="8">
                        <Grid.Resources>
                            <SolidColorBrush x:Name="CheckerColorBrush" x:Key="CheckerColorBrush" Color="#888888" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="164" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <primitives:ColorSpectrum x:Name="ColorSpectrum" Width="148" Height="148" Margin="8"
                            MinWidth="0" MinHeight="0" CornerRadius="4"
                            MinHue="{TemplateBinding MinHue}" MaxHue="{TemplateBinding MaxHue}"
                            MinSaturation="{TemplateBinding MinSaturation}" MaxSaturation="{TemplateBinding MaxSaturation}"
                            MinValue="{TemplateBinding MinValue}" MaxValue="{TemplateBinding MaxValue}"
                            Shape="{TemplateBinding ColorSpectrumShape}" Components="{TemplateBinding ColorSpectrumComponents}" />
                        <Grid Grid.Column="1" Margin="0,8">
                            <Rectangle Width="18" RadiusX="9" RadiusY="9">
                                <Rectangle.Fill>
                                    <LinearGradientBrush x:Name="ThirdDimensionSliderGradientBrush" StartPoint="0,1" EndPoint="0,0" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <primitives:ColorPickerSlider x:Name="ThirdDimensionSlider" Orientation="Vertical"
                                Style="{StaticResource BasColorPickerSliderStyle}" Margin="0,-3"
                                Minimum="0" Maximum="359" Width="20" MinWidth="0" IsThumbToolTipEnabled="False" />
                        </Grid>
                        <Grid Grid.Column="2" Margin="0,8">
                            <Rectangle Width="18" RadiusX="9" RadiusY="9">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="AlphaSliderCheckeredBackgroundImageBrush" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="AlphaSliderBackgroundRectangle" Width="18" RadiusX="9" RadiusY="9">
                                <Rectangle.Fill>
                                    <LinearGradientBrush x:Name="AlphaSliderGradientBrush" StartPoint="0,1" EndPoint="0,0" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <primitives:ColorPickerSlider x:Name="AlphaSlider" Orientation="Vertical"
                                Style="{StaticResource BasColorPickerSliderStyle}" Margin="0,-3"
                                Minimum="0" Maximum="100" Width="20" MinWidth="0" IsThumbToolTipEnabled="False" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasColorPresetsStyle" TargetType="RadioButtons">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButtons">
                    <ItemsRepeater x:Name="InnerRepeater">
                        <ItemsRepeater.Layout>
                            <local:ColorPresetLayout />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasColorSwatchStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SwatchRoot" Background="{TemplateBinding Background}" CornerRadius="5"
                            BorderThickness="2" BorderBrush="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SwatchRoot.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SwatchRoot.Opacity" Value="0.65" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SwatchRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="SwatchRoot.BorderBrush" Value="{ThemeResource BasSettingsAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasSegmentedRadioButtonsStyle" TargetType="RadioButtons">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButtons">
                    <Grid>
                        <Border x:Name="SegmentedSelection" Background="{ThemeResource BasSettingsAccentBrush}"
                                CornerRadius="3" Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="0" />
                        <ItemsRepeater x:Name="InnerRepeater">
                            <ItemsRepeater.Layout>
                                <local:SegmentedRadioLayout />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasSegmentedRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource BasFontSizeBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
